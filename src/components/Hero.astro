---
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import hero from '../assets/hero.png';
import { RELEASES } from '../config';
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).hero;
---
<header class="hero">
  <div class="wrap">
    <Image src={icon} alt="" width={88} height={88} class="icon" />
    <h1>{t.headline[0]}<br /><span>{t.headline[1]}</span></h1>
    <p class="lead">{t.lead}</p>
    <p class="actions">
      <a class="button" href={RELEASES}>{t.download}</a>
      <a class="button secondary" href="#install">{t.install}</a>
    </p>
    <p class="note">{t.note}</p>
    <Image src={hero} alt={t.heroAlt} widths={[640, 1080, 1600]} sizes="(min-width: 1120px) 1088px, 100vw" class="shot" loading="eager" />
  </div>
</header>

<style>
  .hero {
    padding: 72px 0 96px;
    background:
      radial-gradient(60% 50% at 15% 0%, rgb(255 107 61 / 0.35), transparent 70%),
      radial-gradient(50% 45% at 90% 20%, rgb(255 61 129 / 0.25), transparent 70%);
  }
  .icon { margin-bottom: 32px; }
  h1 span { color: var(--accent); }
  .actions { display: flex; gap: 14px; flex-wrap: wrap; margin: 32px 0 14px; }
  .note { color: var(--muted); font: 0.85rem var(--mono); }
  .shot { margin-top: 56px; box-shadow: 14px 14px 0 var(--accent); }
</style>
