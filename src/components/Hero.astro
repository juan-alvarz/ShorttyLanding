---
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import { RELEASES, REPO } from '../config';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
const [before, selected, after] = t.hero.headline;
---
<header class="hero" data-capture-area data-try-text={`${t.hero.tryIt} →`} data-try-href={RELEASES}>
  <nav class="wrap">
    <a class="brand" href="#top" aria-label="Shortty">
      <Image src={icon} alt="" width={36} height={36} />
      <span>shortty</span>
    </a>
    <ul>
      <li class="optional"><a href="#capture">{t.nav.capture}</a></li>
      <li class="optional"><a href="#edit">{t.nav.edit}</a></li>
      <li class="optional"><a href="#layouts">{t.nav.layouts}</a></li>
      <li class="optional"><a href="#install">{t.nav.install}</a></li>
      <li><a href={REPO}>{t.nav.github}</a></li>
      <li><a class="button" href={RELEASES}>{t.nav.download}</a></li>
    </ul>
  </nav>

  <div class="wrap intro" id="top">
    <h1>
      <span>{before}</span>
      <em class="selection" data-measure>
        {selected}
        <i class="handle"></i><i class="handle"></i><i class="handle"></i><i class="handle"></i>
        <span class="size" aria-hidden="true">— × —</span>
      </em>
      <span>{after}</span>
    </h1>
    <div class="side">
      <p class="lead">{t.hero.lead}</p>
      <p class="actions">
        <a class="button" href={RELEASES}>{t.hero.download} ↓</a>
        <a class="button ghost" href="#install">{t.hero.install}</a>
      </p>
      <p class="hint" aria-hidden="true">+ {t.hero.hint}</p>
    </div>
  </div>

</header>

<script>
  // Shows the real size of the framed headline word, and lets mouse users drag
  // a selection over the hero, like Shortty's Capture Region.
  const area = document.querySelector<HTMLElement>('[data-capture-area]')!;
  const measured = area.querySelector<HTMLElement>('[data-measure]')!;

  const sizeText = (w: number, h: number) => `${Math.round(w)} × ${Math.round(h)}`;
  const showMeasured = () => {
    const r = measured.getBoundingClientRect();
    measured.querySelector('.size')!.textContent = sizeText(r.width, r.height);
  };
  showMeasured();
  addEventListener('resize', showMeasured);

  let box: HTMLElement | null = null;
  let start = { x: 0, y: 0 };

  const clear = () => { box?.remove(); box = null; };

  area.addEventListener('pointerdown', (e) => {
    if (e.pointerType === 'touch' || e.button !== 0) return;
    if ((e.target as Element).closest('a, button, nav')) return;
    clear();
    const origin = area.getBoundingClientRect();
    start = { x: e.clientX - origin.left, y: e.clientY - origin.top };
    box = document.createElement('div');
    box.className = 'selection live';
    box.innerHTML = '<i class="handle"></i><i class="handle"></i><i class="handle"></i><i class="handle"></i><span class="size"></span>';
    area.append(box);
    area.setPointerCapture(e.pointerId);
    e.preventDefault();
  });

  area.addEventListener('pointermove', (e) => {
    if (!box || !area.hasPointerCapture(e.pointerId)) return;
    const origin = area.getBoundingClientRect();
    const x = e.clientX - origin.left;
    const y = e.clientY - origin.top;
    const w = Math.abs(x - start.x);
    const h = Math.abs(y - start.y);
    Object.assign(box.style, {
      left: `${Math.min(x, start.x)}px`,
      top: `${Math.min(y, start.y)}px`,
      width: `${w}px`,
      height: `${h}px`,
    });
    box.querySelector('.size')!.textContent = sizeText(w, h);
  });

  area.addEventListener('pointerup', (e) => {
    if (!box || !area.hasPointerCapture(e.pointerId)) return;
    area.releasePointerCapture(e.pointerId);
    if (box.offsetWidth < 12 || box.offsetHeight < 12) return clear();
    const link = document.createElement('a');
    link.className = 'try';
    link.href = area.dataset.tryHref!;
    link.textContent = area.dataset.tryText!;
    box.append(link);
  });

  addEventListener('keydown', (e) => { if (e.key === 'Escape') clear(); });
</script>

<style>
  .hero { position: relative; cursor: crosshair; background: radial-gradient(60% 70% at 80% 10%, rgb(255 107 61 / 0.16), transparent 70%), var(--dark); color: var(--white); }
  .hero a, .hero nav { cursor: pointer; }

  nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 24px; cursor: default; }
  .brand { display: flex; align-items: center; gap: 12px; font: italic 400 1.6rem/1 var(--display); text-decoration: none; }
  .brand :global(img) { width: 34px; height: 34px; }
  nav ul { display: flex; align-items: center; gap: 28px; list-style: none; margin: 0; padding: 0; font-size: 0.95rem; }
  nav ul a:not(.button) { text-decoration: none; color: var(--on-dark-muted); }
  nav ul a:not(.button):hover { color: var(--white); }
  nav .button { padding: 11px 16px; }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: end;
    gap: 48px;
    min-height: calc(100vh - 92px);
    padding-block: clamp(48px, 8vw, 96px);
  }
  h1 { font: 400 var(--step-4)/0.95 var(--display); letter-spacing: -0.03em; }
  h1 > span, h1 > em { display: block; width: fit-content; }
  h1 .selection { margin-block: 0.08em 0.3em; padding-inline: 0.06em; color: var(--accent); }
  h1 .size { font-size: 0.75rem; }

  .side { display: flex; flex-direction: column; gap: 28px; }
  .side .lead { margin: 0; color: var(--white); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }
  .hint { color: var(--on-dark-muted); font: 0.78rem var(--mono); }
  .hint::after { content: '  ·  scroll ↓'; }

  .hero :global(.selection.live) { position: absolute; z-index: 5; pointer-events: none; background: rgb(255 107 61 / 0.06); }
  .hero :global(.try) { pointer-events: auto; position: absolute; left: -2px; top: calc(100% + 36px); padding: 6px 10px; background: var(--white); color: var(--dark); font: 600 0.8rem/1 var(--sans); font-style: normal; text-decoration: none; white-space: nowrap; }

  @media (max-width: 900px) {
    .intro { grid-template-columns: minmax(0, 1fr); min-height: 0; }
    .optional { display: none; }
    .hint { display: none; }
  }
</style>
