---
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import { RELEASES, REPO } from '../config';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
const [before, selected, after] = t.hero.headline;
---
<header class="hero" data-capture-area data-try-text={`${t.hero.tryIt} →`} data-try-href={RELEASES}>
  <nav>
    <a class="brand" href="#top" aria-label="Shortty">
      <Image src={icon} alt="" width={40} height={40} />
      <span>Shortty</span>
    </a>
    <ul>
      <li><a href="#capture">{t.nav.capture}</a></li>
      <li><a href="#edit">{t.nav.edit}</a></li>
      <li><a href="#layouts">{t.nav.layouts}</a></li>
      <li><a href="#install">{t.nav.install}</a></li>
      <li><a href={REPO}>{t.nav.github}</a></li>
    </ul>
  </nav>

  <div class="intro" id="top">
    <h1>
      <span>{before}</span>
      <span class="selection" data-measure>
        {selected}
        <i class="handle"></i><i class="handle"></i><i class="handle"></i><i class="handle"></i>
        <span class="size" aria-hidden="true">— × —</span>
      </span>
      <span>{after}</span>
    </h1>
    <p class="lead">{t.hero.lead}</p>
    <p class="actions">
      <a class="button" href={RELEASES}>{t.hero.download} ↓</a>
      <a class="button ghost" href="#install">{t.hero.install}</a>
    </p>
  </div>

  <p class="hint" aria-hidden="true">+ {t.hero.hint}</p>
</header>

<script>
  // Shows the real size of the framed headline word, and lets mouse users drag
  // a selection over the hero, like Shortty's Capture Region.
  const area = document.querySelector<HTMLElement>('[data-capture-area]')!;
  const measured = area.querySelector<HTMLElement>('[data-measure]')!;

  const sizeText = (w: number, h: number) => `${Math.round(w)} × ${Math.round(h)}`;
  const showMeasured = () => {
    const r = measured.getBoundingClientRect();
    measured.querySelector('.size')!.textContent = sizeText(r.width, r.height);
  };
  showMeasured();
  addEventListener('resize', showMeasured);

  let box: HTMLElement | null = null;
  let start = { x: 0, y: 0 };

  const clear = () => { box?.remove(); box = null; };

  area.addEventListener('pointerdown', (e) => {
    if (e.pointerType === 'touch' || e.button !== 0) return;
    if ((e.target as Element).closest('a, button, nav')) return;
    clear();
    const origin = area.getBoundingClientRect();
    start = { x: e.clientX - origin.left, y: e.clientY - origin.top };
    box = document.createElement('div');
    box.className = 'selection live';
    box.innerHTML = '<i class="handle"></i><i class="handle"></i><i class="handle"></i><i class="handle"></i><span class="size"></span>';
    area.append(box);
    area.setPointerCapture(e.pointerId);
    e.preventDefault();
  });

  area.addEventListener('pointermove', (e) => {
    if (!box || !area.hasPointerCapture(e.pointerId)) return;
    const origin = area.getBoundingClientRect();
    const x = e.clientX - origin.left;
    const y = e.clientY - origin.top;
    const w = Math.abs(x - start.x);
    const h = Math.abs(y - start.y);
    Object.assign(box.style, {
      left: `${Math.min(x, start.x)}px`,
      top: `${Math.min(y, start.y)}px`,
      width: `${w}px`,
      height: `${h}px`,
    });
    box.querySelector('.size')!.textContent = sizeText(w, h);
  });

  area.addEventListener('pointerup', (e) => {
    if (!box || !area.hasPointerCapture(e.pointerId)) return;
    area.releasePointerCapture(e.pointerId);
    if (box.offsetWidth < 12 || box.offsetHeight < 12) return clear();
    const link = document.createElement('a');
    link.className = 'try';
    link.href = area.dataset.tryHref!;
    link.textContent = area.dataset.tryText!;
    box.append(link);
  });

  addEventListener('keydown', (e) => { if (e.key === 'Escape') clear(); });
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
    min-height: 100vh;
    padding: 28px max(24px, env(safe-area-inset-left, 0px)) 32px;
    cursor: crosshair;
    background: var(--primary);
    color: var(--white);
  }
  @media (min-width: 1040px) {
    .hero { position: sticky; top: 0; height: 100vh; padding-inline: clamp(32px, 4vw, 64px); }
  }
  .hero a, .hero nav { cursor: pointer; }

  nav { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px 24px; cursor: default; }
  .brand { display: flex; align-items: center; gap: 12px; font: 800 1.2rem/1 var(--display); font-stretch: 125%; text-transform: uppercase; text-decoration: none; }
  .brand :global(img) { width: 40px; height: 40px; }
  nav ul { display: flex; flex-wrap: wrap; gap: 8px 20px; list-style: none; margin: 0; padding: 0; font: 500 0.75rem/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; }
  nav ul a { text-decoration: none; color: var(--on-primary-muted); }
  nav ul a:hover { color: var(--accent); }

  h1 { font: 800 var(--step-4)/0.92 var(--display); font-stretch: 125%; letter-spacing: -0.03em; text-transform: uppercase; }
  h1 > span { display: block; width: fit-content; }
  h1 .selection { margin-block: 0.1em 0.34em; padding-inline: 0.05em; }
  h1 .size { font-size: 0.8rem; letter-spacing: 0; }

  .lead { margin-top: 36px; color: var(--on-primary-muted); max-width: 40ch; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 36px; }
  .hint { color: var(--on-primary-muted); font: 0.75rem var(--mono); letter-spacing: 0.06em; }

  .hero :global(.selection.live) { position: absolute; z-index: 5; pointer-events: none; background: rgb(255 107 61 / 0.08); }
  .hero :global(.try) { pointer-events: auto; position: absolute; left: -2px; top: calc(100% + 34px); padding: 6px 10px; background: var(--white); color: var(--dark); font: 600 0.8rem/1 var(--mono); text-decoration: none; white-space: nowrap; }
  .hero :global(.try:hover) { background: var(--accent); }

  @media (max-width: 1039px) {
    .hero { min-height: 0; }
    .hint { display: none; }
  }

  /* On phones the headline lines sit close together: leave room for the size tag under the frame. */
  @media (max-width: 600px) {
    h1 .selection { margin-bottom: 40px; }
  }
</style>
