---
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import hero from '../assets/hero.png';
import { RELEASES, REPO } from '../config';
import { useTranslations } from '../i18n';
import { toAscii } from '../lib/ascii';

const t = useTranslations(Astro.currentLocale);
const cat = await toAscii('public/icon.svg', 64, 30);
const [before, selected, after] = t.hero.headline;
---
<header class="hero" data-capture-area data-try-text={`${t.hero.tryIt} →`} data-try-href={RELEASES}>
  <nav class="wrap">
    <a class="brand" href="#top" aria-label="Shortty">
      <Image src={icon} alt="" width={36} height={36} />
      <span>~/shortty</span>
    </a>
    <ul>
      <li class="optional"><a href="#capture">{t.nav.capture}</a></li>
      <li class="optional"><a href="#edit">{t.nav.edit}</a></li>
      <li class="optional"><a href="#layouts">{t.nav.layouts}</a></li>
      <li class="optional"><a href="#install">{t.nav.install}</a></li>
      <li><a href={REPO}>{t.nav.github}</a></li>
      <li><a class="button" href={RELEASES}>{t.nav.download}</a></li>
    </ul>
  </nav>

  <div class="wrap intro" id="top">
    <pre class="cat" aria-hidden="true">{cat}</pre>
    <div class="text">
      <p class="prompt" aria-hidden="true"><span>$</span> open -a Shortty</p>
      <h1>
        <span>{before}</span>
        <span class="selection" data-measure>
          {selected}
          <i class="handle"></i><i class="handle"></i><i class="handle"></i><i class="handle"></i>
          <span class="size" aria-hidden="true">— × —</span>
        </span>
        <span>{after}<i class="cursor" aria-hidden="true"></i></span>
      </h1>
      <p class="lead">{t.hero.lead}</p>
      <p class="actions">
        <a class="button" href={RELEASES}>{t.hero.download}</a>
        <a class="button ghost" href="#install">{t.hero.install}</a>
      </p>
      <p class="hint" aria-hidden="true">{t.hero.hint}</p>
    </div>
  </div>

  <figure class="shot wrap">
    <div class="viewfinder">
      <Image src={hero} alt={t.hero.shotAlt} widths={[640, 1080, 1600]} sizes="(min-width: 1200px) 1130px, 100vw" loading="eager" />
    </div>
    <figcaption>{t.hero.shotLabel}</figcaption>
  </figure>
</header>

<script>
  // Shows the real size of the framed headline word, and lets mouse users drag
  // a selection over the hero, like Shortty's Capture Region.
  const area = document.querySelector<HTMLElement>('[data-capture-area]')!;
  const measured = area.querySelector<HTMLElement>('[data-measure]')!;

  const sizeText = (w: number, h: number) => `${Math.round(w)} × ${Math.round(h)}`;
  const showMeasured = () => {
    const r = measured.getBoundingClientRect();
    measured.querySelector('.size')!.textContent = sizeText(r.width, r.height);
  };
  showMeasured();
  addEventListener('resize', showMeasured);

  let box: HTMLElement | null = null;
  let start = { x: 0, y: 0 };

  const clear = () => { box?.remove(); box = null; };

  area.addEventListener('pointerdown', (e) => {
    if (e.pointerType === 'touch' || e.button !== 0) return;
    if ((e.target as Element).closest('a, button, nav')) return;
    clear();
    const origin = area.getBoundingClientRect();
    start = { x: e.clientX - origin.left, y: e.clientY - origin.top };
    box = document.createElement('div');
    box.className = 'selection live';
    box.innerHTML = '<i class="handle"></i><i class="handle"></i><i class="handle"></i><i class="handle"></i><span class="size"></span>';
    area.append(box);
    area.setPointerCapture(e.pointerId);
    e.preventDefault();
  });

  area.addEventListener('pointermove', (e) => {
    if (!box || !area.hasPointerCapture(e.pointerId)) return;
    const origin = area.getBoundingClientRect();
    const x = e.clientX - origin.left;
    const y = e.clientY - origin.top;
    const w = Math.abs(x - start.x);
    const h = Math.abs(y - start.y);
    Object.assign(box.style, {
      left: `${Math.min(x, start.x)}px`,
      top: `${Math.min(y, start.y)}px`,
      width: `${w}px`,
      height: `${h}px`,
    });
    box.querySelector('.size')!.textContent = sizeText(w, h);
  });

  area.addEventListener('pointerup', (e) => {
    if (!box || !area.hasPointerCapture(e.pointerId)) return;
    area.releasePointerCapture(e.pointerId);
    if (box.offsetWidth < 12 || box.offsetHeight < 12) return clear();
    const link = document.createElement('a');
    link.className = 'try';
    link.href = area.dataset.tryHref!;
    link.textContent = area.dataset.tryText!;
    box.append(link);
  });

  addEventListener('keydown', (e) => { if (e.key === 'Escape') clear(); });
</script>

<style>
  .hero { position: relative; cursor: crosshair; background: var(--dark); color: var(--white); }
  .hero a, .hero nav { cursor: pointer; }

  nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 20px; cursor: default; }
  .brand { display: flex; align-items: center; gap: 10px; font: 500 0.95rem/1 var(--mono); text-decoration: none; color: var(--white); }
  .brand :global(img) { width: 28px; height: 28px; }
  nav ul { display: flex; align-items: center; gap: 24px; list-style: none; margin: 0; padding: 0; font-size: 0.9rem; }
  nav ul a:not(.button) { text-decoration: none; color: var(--on-dark-muted); }
  nav ul a:not(.button):hover { color: var(--accent); }
  nav ul a:not(.button)::before { content: './'; color: var(--light-raised); }
  nav .button { padding: 10px 14px; }

  .intro {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
    padding-block: clamp(48px, 8vw, 104px);
  }
  .cat { margin: 0; color: var(--accent); font: 600 clamp(6px, 0.95vw, 12px)/1.1 var(--mono); text-shadow: 0 0 12px rgb(255 122 77 / 0.45); }
  .prompt { color: var(--on-dark-muted); margin-bottom: 20px; }
  .prompt span { color: var(--accent); }
  h1 { font: 700 var(--step-4)/1.05 var(--display); letter-spacing: -0.06em; }
  h1 > span { display: block; width: fit-content; }
  h1 .selection { margin-block: 0.12em 0.32em; padding-inline: 0.08em; }
  h1 .size { font-size: 0.8rem; letter-spacing: 0; }
  .cursor { display: inline-block; width: 0.5em; height: 0.85em; margin-left: 0.12em; vertical-align: -0.05em; background: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    .cursor { animation: blink 1.1s steps(1) infinite; }
    @keyframes blink { 50% { opacity: 0; } }
  }

  .text .lead { margin-top: 28px; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 32px; }
  .hint { margin-top: 24px; color: var(--on-dark-muted); font-size: 0.8rem; }
  .hint::before { content: '# '; color: var(--light-raised); }

  .shot { margin-top: 0; margin-bottom: 0; padding-bottom: clamp(56px, 8vw, 104px); }
  .shot :global(img) { width: 100%; }
  figcaption { margin-top: 12px; color: var(--on-dark-muted); font-size: 0.8rem; }
  figcaption::before { content: '^ '; color: var(--accent); }

  .hero :global(.selection.live) { position: absolute; z-index: 5; pointer-events: none; background: rgb(255 122 77 / 0.06); }
  .hero :global(.try) { pointer-events: auto; position: absolute; left: 0; top: calc(100% + 30px); padding: 6px 10px; background: var(--accent); color: var(--dark); font: 600 0.8rem/1 var(--mono); text-decoration: none; white-space: nowrap; }
  .hero :global(.try:hover) { background: var(--signal); }

  @media (max-width: 900px) {
    .intro { grid-template-columns: minmax(0, 1fr); }
    .cat { font-size: clamp(5px, 1.6vw, 9px); }
    .optional { display: none; }
    .hint { display: none; }
  }

  /* On phones the headline lines sit close together: leave room for the size tag under the frame. */
  @media (max-width: 600px) {
    h1 .selection { margin-bottom: 40px; }
  }
</style>
