---
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import hero from '../assets/hero.png';
import { RELEASES, REPO } from '../config';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
const [before, selected, after] = t.hero.headline;
---
<header class="hero" data-capture-area data-try-text={`${t.hero.tryIt} →`} data-try-href={RELEASES}>
  <nav class="wrap">
    <a class="brand" href="#top" aria-label="Shortty">
      <Image src={icon} alt="" width={36} height={36} />
      <span>shortty</span>
    </a>
    <ul>
      <li class="optional"><a href="#capture">{t.nav.capture}</a></li>
      <li class="optional"><a href="#edit">{t.nav.edit}</a></li>
      <li class="optional"><a href="#layouts">{t.nav.layouts}</a></li>
      <li class="optional"><a href="#install">{t.nav.install}</a></li>
      <li><a href={REPO}>{t.nav.github}</a></li>
      <li><a class="button" href={RELEASES}>{t.nav.download}</a></li>
    </ul>
  </nav>

  <div class="wrap intro" id="top">
    <ol class="boot" aria-hidden="true">
      {t.specs.map((spec, i) => <li style={`--i: ${i}`}>{spec} <span>OK</span></li>)}
    </ol>
    <h1>
      <span>{before}</span>
      <span class="selection" data-measure>
        {selected}
        <i class="handle"></i><i class="handle"></i><i class="handle"></i><i class="handle"></i>
        <span class="size" aria-hidden="true">— × —</span>
      </span>
      <span>{after}</span>
    </h1>
    <div class="side">
      <p class="lead">{t.hero.lead}</p>
      <p class="actions">
        <a class="button" href={RELEASES}>{t.hero.download} ↓</a>
        <a class="button ghost" href="#install">{t.hero.install}</a>
      </p>
      <p class="hint" aria-hidden="true">+ {t.hero.hint}</p>
    </div>
  </div>

  <figure class="shot wrap">
    <div class="viewfinder">
      <Image src={hero} alt={t.hero.shotAlt} widths={[640, 1080, 1600]} sizes="(min-width: 1200px) 1130px, 100vw" loading="eager" />
    </div>
    <figcaption>{t.hero.shotLabel}</figcaption>
  </figure>
</header>

<script>
  // Shows the real size of the framed headline word, and lets mouse users drag
  // a selection over the hero, like Shortty's Capture Region.
  const area = document.querySelector<HTMLElement>('[data-capture-area]')!;
  const measured = area.querySelector<HTMLElement>('[data-measure]')!;

  const sizeText = (w: number, h: number) => `${Math.round(w)} × ${Math.round(h)}`;
  const showMeasured = () => {
    const r = measured.getBoundingClientRect();
    measured.querySelector('.size')!.textContent = sizeText(r.width, r.height);
  };
  showMeasured();
  addEventListener('resize', showMeasured);

  let box: HTMLElement | null = null;
  let start = { x: 0, y: 0 };

  const clear = () => { box?.remove(); box = null; };

  area.addEventListener('pointerdown', (e) => {
    if (e.pointerType === 'touch' || e.button !== 0) return;
    if ((e.target as Element).closest('a, button, nav')) return;
    clear();
    const origin = area.getBoundingClientRect();
    start = { x: e.clientX - origin.left, y: e.clientY - origin.top };
    box = document.createElement('div');
    box.className = 'selection live';
    box.innerHTML = '<i class="handle"></i><i class="handle"></i><i class="handle"></i><i class="handle"></i><span class="size"></span>';
    area.append(box);
    area.setPointerCapture(e.pointerId);
    e.preventDefault();
  });

  area.addEventListener('pointermove', (e) => {
    if (!box || !area.hasPointerCapture(e.pointerId)) return;
    const origin = area.getBoundingClientRect();
    const x = e.clientX - origin.left;
    const y = e.clientY - origin.top;
    const w = Math.abs(x - start.x);
    const h = Math.abs(y - start.y);
    Object.assign(box.style, {
      left: `${Math.min(x, start.x)}px`,
      top: `${Math.min(y, start.y)}px`,
      width: `${w}px`,
      height: `${h}px`,
    });
    box.querySelector('.size')!.textContent = sizeText(w, h);
  });

  area.addEventListener('pointerup', (e) => {
    if (!box || !area.hasPointerCapture(e.pointerId)) return;
    area.releasePointerCapture(e.pointerId);
    if (box.offsetWidth < 12 || box.offsetHeight < 12) return clear();
    const link = document.createElement('a');
    link.className = 'try';
    link.href = area.dataset.tryHref!;
    link.textContent = area.dataset.tryText!;
    box.append(link);
  });

  addEventListener('keydown', (e) => { if (e.key === 'Escape') clear(); });
</script>

<style>
  .hero { position: relative; cursor: crosshair; background: radial-gradient(70% 60% at 50% 30%, #1d1508, var(--dark) 70%); color: var(--white); }
  .hero a, .hero nav { cursor: pointer; }

  nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 18px; cursor: default; }
  .brand { display: flex; align-items: center; gap: 12px; font: 400 2rem/1 var(--display); color: var(--accent); text-shadow: var(--glow); text-transform: uppercase; text-decoration: none; }
  .brand :global(img) { width: 34px; height: 34px; filter: sepia(1) saturate(3) hue-rotate(-10deg) brightness(0.95); }
  nav ul { display: flex; align-items: center; gap: 24px; list-style: none; margin: 0; padding: 0; font: 400 1.5rem/1 var(--display); text-transform: uppercase; }
  nav ul a:not(.button) { text-decoration: none; color: var(--on-dark-muted); }
  nav ul a:not(.button):hover { color: var(--accent); }
  nav .button { padding: 6px 12px; font-size: 1.4rem; }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    grid-template-areas: 'boot boot' 'title side';
    align-items: end;
    gap: 32px 48px;
    padding-block: clamp(32px, 6vw, 72px) clamp(48px, 6vw, 80px);
  }
  .boot { grid-area: boot; list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 48px; color: var(--on-dark-muted); font: 400 1.3rem/1.25 var(--display); text-transform: uppercase; }
  .boot li::before { content: '> '; }
  .boot li { display: flex; gap: 8px; }
  .boot li::after { content: ''; flex: 1; order: 1; margin-bottom: 0.3em; background: radial-gradient(circle, var(--on-dark-muted) 1px, transparent 1.5px) bottom / 8px 4px repeat-x; }
  .boot span { order: 2; color: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    .boot li { animation: boot 0.01s calc(var(--i) * 0.12s) both; }
    @keyframes boot { from { visibility: hidden; } }
  }

  h1 { grid-area: title; font: 400 var(--step-4)/0.8 var(--display); color: var(--accent); text-shadow: var(--glow); text-transform: uppercase; }
  h1 > span { display: block; width: fit-content; }
  h1 .selection { margin-block: 0.08em 0.24em; padding-inline: 0.06em; }

  .side { grid-area: side; display: flex; flex-direction: column; gap: 26px; }
  .side .lead { margin: 0; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }
  .hint { color: var(--on-dark-muted); font: 400 1.25rem var(--display); text-transform: uppercase; }

  .shot { margin-top: 0; margin-bottom: 0; padding-bottom: clamp(56px, 8vw, 104px); }
  .shot :global(img) { width: 100%; }
  figcaption { margin-top: 12px; color: var(--on-dark-muted); font: 400 1.3rem var(--display); text-transform: uppercase; }

  .hero :global(.selection.live) { position: absolute; z-index: 5; pointer-events: none; background: rgb(255 176 0 / 0.06); }
  .hero :global(.try) { pointer-events: auto; position: absolute; left: -2px; top: calc(100% + 34px); padding: 3px 10px; background: var(--hot); color: var(--dark); font: 400 1.3rem/1 var(--display); text-transform: uppercase; text-shadow: none; text-decoration: none; white-space: nowrap; }

  @media (max-width: 900px) {
    .intro { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'boot' 'title' 'side'; }
    .boot { columns: 1; }
    .optional { display: none; }
    .hint { display: none; }
  }
</style>
