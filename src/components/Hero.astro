---
import { Image } from 'astro:assets';
import hero from '../assets/hero.png';
import { RELEASES, REPO } from '../config';
import { useTranslations } from '../i18n';
import { dither } from '../lib/dither';

const t = useTranslations(Astro.currentLocale);
// Ink blue on bone, matching --dark and --light.
const ink: [number, number, number] = [24, 32, 170];
const bone: [number, number, number] = [232, 232, 226];
const shotDots = await dither('src/assets/hero.png', 565, ink, bone);
const catDots = await dither('public/icon.svg', 96, ink, bone);
const [before, selected, after] = t.hero.headline;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!-- Sticky: stays at the top while scrolling and marks the section on screen (see src/scripts/scroll.ts). -->
<div class="navbar" data-navbar>
  <nav class="wrap" aria-label={t.nav.label}>
    <a class="brand" href="#top" aria-label="Shortty">
      <img src={`${base}/icon.svg`} alt="" width="36" height="36" />
      <span>shortty</span>
      <span class="where" data-where aria-hidden="true"></span>
    </a>
    <ul>
      <li class="optional"><a href="#capture" data-nav>{t.nav.capture}</a></li>
      <li class="optional"><a href="#edit" data-nav>{t.nav.edit}</a></li>
      <li class="optional"><a href="#layouts" data-nav>{t.nav.layouts}</a></li>
      <li class="optional"><a href="#install" data-nav>{t.nav.install}</a></li>
      <li class="optional"><a href="#releases" data-nav>{t.nav.releases}</a></li>
      <li class="github"><a href={REPO}>{t.nav.github}</a></li>
      <li><a class="button" href={RELEASES}>{t.nav.download}</a></li>
    </ul>
  </nav>
</div>

<header class="hero" id="top" data-capture-area data-try-text={`${t.hero.tryIt} →`} data-try-href={RELEASES}>
  <div class="wrap intro">
    <img class="cat" src={catDots} alt="" width="96" height="96" />
    <h1>
      <span>{before}</span>
      <span class="selection" data-measure>
        {selected}
        <i class="handle"></i><i class="handle"></i><i class="handle"></i><i class="handle"></i>
        <span class="size" aria-hidden="true">— × —</span>
      </span>
      <span>{after}</span>
    </h1>
    <div class="side">
      <p class="lead">{t.hero.lead}</p>
      <p class="actions">
        <a class="button" href={RELEASES}>{t.hero.download} ↓</a>
        <a class="button ghost" href="#install">{t.hero.install}</a>
      </p>
      <p class="hint" aria-hidden="true">+ {t.hero.hint}</p>
    </div>
  </div>

  <figure class="shot wrap">
    <div class="viewfinder">
      <div class="stack">
        <Image src={hero} alt={t.hero.shotAlt} widths={[640, 1080, 1600]} sizes="(min-width: 1200px) 1130px, 100vw" loading="eager" />
        <img class="dots" src={shotDots} alt="" />
      </div>
    </div>
    <figcaption>{t.hero.shotLabel}</figcaption>
  </figure>
</header>

<script>
  // Shows the real size of the framed headline word, and lets mouse users drag
  // a selection over the hero, like Shortty's Capture Region.
  const area = document.querySelector<HTMLElement>('[data-capture-area]')!;
  const measured = area.querySelector<HTMLElement>('[data-measure]')!;

  const sizeText = (w: number, h: number) => `${Math.round(w)} × ${Math.round(h)}`;
  const showMeasured = () => {
    const r = measured.getBoundingClientRect();
    measured.querySelector('.size')!.textContent = sizeText(r.width, r.height);
  };
  showMeasured();
  addEventListener('resize', showMeasured);

  let box: HTMLElement | null = null;
  let start = { x: 0, y: 0 };

  const clear = () => { box?.remove(); box = null; };

  area.addEventListener('pointerdown', (e) => {
    if (e.pointerType === 'touch' || e.button !== 0) return;
    if ((e.target as Element).closest('a, button, nav')) return;
    clear();
    const origin = area.getBoundingClientRect();
    start = { x: e.clientX - origin.left, y: e.clientY - origin.top };
    box = document.createElement('div');
    box.className = 'selection live';
    box.innerHTML = '<i class="handle"></i><i class="handle"></i><i class="handle"></i><i class="handle"></i><span class="size"></span>';
    area.append(box);
    area.setPointerCapture(e.pointerId);
    e.preventDefault();
  });

  area.addEventListener('pointermove', (e) => {
    if (!box || !area.hasPointerCapture(e.pointerId)) return;
    const origin = area.getBoundingClientRect();
    const x = e.clientX - origin.left;
    const y = e.clientY - origin.top;
    const w = Math.abs(x - start.x);
    const h = Math.abs(y - start.y);
    Object.assign(box.style, {
      left: `${Math.min(x, start.x)}px`,
      top: `${Math.min(y, start.y)}px`,
      width: `${w}px`,
      height: `${h}px`,
    });
    box.querySelector('.size')!.textContent = sizeText(w, h);
  });

  area.addEventListener('pointerup', (e) => {
    if (!box || !area.hasPointerCapture(e.pointerId)) return;
    area.releasePointerCapture(e.pointerId);
    if (box.offsetWidth < 12 || box.offsetHeight < 12) return clear();
    const link = document.createElement('a');
    link.className = 'try';
    link.href = area.dataset.tryHref!;
    link.textContent = area.dataset.tryText!;
    box.append(link);
  });

  addEventListener('keydown', (e) => { if (e.key === 'Escape') clear(); });
</script>

<style>
  .hero { position: relative; cursor: crosshair; background: var(--light); color: var(--dark); }
  .hero a { cursor: pointer; }

  .navbar { position: sticky; top: 0; z-index: 50; background: var(--light); color: var(--dark); }
  /* Once scrolled, the bar gets the page's dotted rule. */
  .navbar[data-scrolled] { background: linear-gradient(90deg, var(--dark) 50%, transparent 0) bottom / 6px 1px repeat-x, var(--light); }
  nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 20px; }
  .brand { display: flex; align-items: center; gap: 10px; font: italic 400 1.6rem/1 var(--display); text-decoration: none; }
  .brand img { width: 30px; height: 30px; }
  .where { display: none; font-size: 1.2rem; color: var(--on-light-muted); }
  .where:not(:empty)::before { content: '/ '; }
  nav ul { display: flex; align-items: center; gap: 26px; list-style: none; margin: 0; padding: 0; font: 500 0.75rem/1 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; }
  nav ul a:not(.button) { text-decoration: none; }
  /* The section on screen: an orange rule under the word. */
  nav ul a[aria-current] { box-shadow: 0 6px 0 -4px var(--accent); }
  nav .button { padding: 11px 15px; }

  .intro {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(0, 0.9fr);
    align-items: end;
    gap: 40px;
    padding-block: clamp(48px, 8vw, 104px) clamp(48px, 6vw, 80px);
  }
  .cat { width: clamp(96px, 12vw, 176px); height: auto; image-rendering: pixelated; align-self: start; }
  h1 { font: 400 var(--step-4)/0.9 var(--display); letter-spacing: -0.03em; }
  h1 > span { display: block; width: fit-content; }
  h1 .selection { margin-block: 0.06em 0.26em; padding-inline: 0.04em; font-style: italic; }
  h1 .size { font-size: 0.75rem; }

  .side { display: flex; flex-direction: column; gap: 26px; }
  .side .lead { margin: 0; color: var(--dark); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }
  .hint { color: var(--on-light-muted); font-size: 0.75rem; letter-spacing: 0.04em; }

  .shot { margin-top: 0; margin-bottom: 0; padding-bottom: clamp(56px, 8vw, 104px); }
  .stack { display: grid; }
  .stack > :global(*) { grid-area: 1 / 1; width: 100%; height: 100%; }
  .dots { image-rendering: pixelated; object-fit: cover; transition: opacity 0.35s; }
  .stack:hover .dots { opacity: 0; }
  figcaption { margin-top: 12px; color: var(--on-light-muted); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; }
  figcaption::after { content: ' · hover to develop'; }

  .hero :global(.selection.live) { position: absolute; z-index: 5; pointer-events: none; background: rgb(255 90 42 / 0.06); }
  .hero :global(.try) { pointer-events: auto; position: absolute; left: -1px; top: calc(100% + 32px); padding: 6px 10px; background: var(--dark); color: var(--white); font: 600 0.75rem/1 var(--mono); text-decoration: none; white-space: nowrap; }
  .hero :global(.try:hover) { background: var(--accent); }

  @media (prefers-reduced-motion: reduce) { .dots { transition: none; } }
  @media (hover: none) { figcaption::after { content: ''; } }

  @media (max-width: 1000px) {
    .intro { grid-template-columns: auto minmax(0, 1fr); }
    .side { grid-column: 1 / -1; }
    .optional { display: none; }
    .where { display: inline; }
    .hint { display: none; }
  }
  @media (max-width: 560px) {
    .intro { grid-template-columns: minmax(0, 1fr); }
  }

  /* On phones the headline lines sit close together: leave room for the size tag under the frame. */
  @media (max-width: 600px) {
    h1 .selection { margin-bottom: 40px; }
  }

  /* Phones: the section name takes the GitHub link's place (it is in the footer too). */
  @media (max-width: 480px) {
    .github { display: none; }
  }
</style>
