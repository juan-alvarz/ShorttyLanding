---
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import hero from '../assets/hero.png';
import { RELEASES, REPO } from '../config';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
const [before, selected, after] = t.hero.headline;
---
<header class="hero" data-capture-area data-try-text={`${t.hero.tryIt} →`} data-try-href={RELEASES}>
  <nav class="wrap">
    <a class="brand" href="#top" aria-label="Shortty">
      <Image src={icon} alt="" width={30} height={30} />
      <span>Shortty</span>
    </a>
    <ul>
      <li class="optional"><a href="#capture">{t.nav.capture}</a></li>
      <li class="optional"><a href="#edit">{t.nav.edit}</a></li>
      <li class="optional"><a href="#layouts">{t.nav.layouts}</a></li>
      <li class="optional"><a href="#install">{t.nav.install}</a></li>
      <li><a href={REPO}>{t.nav.github}</a></li>
      <li><a class="button" href={RELEASES}>{t.nav.download}</a></li>
    </ul>
  </nav>
  <p class="masthead wrap" aria-hidden="true">
    <span>{t.footer.tagline}</span>
    <span>{t.specs.slice(5).join(' · ')}</span>
  </p>

  <div class="wrap intro" id="top">
    <h1>
      <span>{before}</span>
      <em class="selection" data-measure>
        {selected}
        <i class="handle"></i><i class="handle"></i><i class="handle"></i><i class="handle"></i>
        <span class="size" aria-hidden="true">— × —</span>
      </em>
      <span>{after}</span>
    </h1>
    <p class="lead">{t.hero.lead}</p>
    <p class="actions">
      <a class="button" href={RELEASES}>{t.hero.download}</a>
      <a class="button ghost" href="#install">{t.hero.install}</a>
    </p>
    <p class="hint" aria-hidden="true">{t.hero.hint}</p>
  </div>

  <figure class="shot">
    <Image src={hero} alt={t.hero.shotAlt} widths={[640, 1080, 1600]} sizes="100vw" loading="eager" />
    <figcaption class="wrap">{t.hero.shotLabel}</figcaption>
  </figure>
</header>

<script>
  // Shows the real size of the framed headline word, and lets mouse users drag
  // a selection over the hero, like Shortty's Capture Region.
  const area = document.querySelector<HTMLElement>('[data-capture-area]')!;
  const measured = area.querySelector<HTMLElement>('[data-measure]')!;

  const sizeText = (w: number, h: number) => `${Math.round(w)} × ${Math.round(h)}`;
  const showMeasured = () => {
    const r = measured.getBoundingClientRect();
    measured.querySelector('.size')!.textContent = sizeText(r.width, r.height);
  };
  showMeasured();
  addEventListener('resize', showMeasured);

  let box: HTMLElement | null = null;
  let start = { x: 0, y: 0 };

  const clear = () => { box?.remove(); box = null; };

  area.addEventListener('pointerdown', (e) => {
    if (e.pointerType === 'touch' || e.button !== 0) return;
    if ((e.target as Element).closest('a, button, nav')) return;
    clear();
    const origin = area.getBoundingClientRect();
    start = { x: e.clientX - origin.left, y: e.clientY - origin.top };
    box = document.createElement('div');
    box.className = 'selection live';
    box.innerHTML = '<i class="handle"></i><i class="handle"></i><i class="handle"></i><i class="handle"></i><span class="size"></span>';
    area.append(box);
    area.setPointerCapture(e.pointerId);
    e.preventDefault();
  });

  area.addEventListener('pointermove', (e) => {
    if (!box || !area.hasPointerCapture(e.pointerId)) return;
    const origin = area.getBoundingClientRect();
    const x = e.clientX - origin.left;
    const y = e.clientY - origin.top;
    const w = Math.abs(x - start.x);
    const h = Math.abs(y - start.y);
    Object.assign(box.style, {
      left: `${Math.min(x, start.x)}px`,
      top: `${Math.min(y, start.y)}px`,
      width: `${w}px`,
      height: `${h}px`,
    });
    box.querySelector('.size')!.textContent = sizeText(w, h);
  });

  area.addEventListener('pointerup', (e) => {
    if (!box || !area.hasPointerCapture(e.pointerId)) return;
    area.releasePointerCapture(e.pointerId);
    if (box.offsetWidth < 12 || box.offsetHeight < 12) return clear();
    const link = document.createElement('a');
    link.className = 'try';
    link.href = area.dataset.tryHref!;
    link.textContent = area.dataset.tryText!;
    box.append(link);
  });

  addEventListener('keydown', (e) => { if (e.key === 'Escape') clear(); });
</script>

<style>
  .hero { position: relative; cursor: crosshair; background: var(--light); color: var(--dark); }
  .hero a, .hero nav { cursor: pointer; }

  nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 22px; cursor: default; }
  .brand { display: flex; align-items: center; gap: 10px; font: italic 400 1.6rem/1 var(--display); text-decoration: none; }
  .brand :global(img) { width: 30px; height: 30px; }
  nav ul { display: flex; align-items: center; gap: 28px; list-style: none; margin: 0; padding: 0; font: 500 0.72rem/1 var(--mono); letter-spacing: 0.16em; text-transform: uppercase; }
  nav ul a:not(.button) { text-decoration: none; }
  nav .button { padding: 12px 16px; }

  .masthead {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-block: 12px;
    font: 500 0.7rem/1.4 var(--mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--on-light-muted);
    background: linear-gradient(var(--dark) 0 0) top / calc(100% - 2 * max(16px, env(safe-area-inset-left, 0px))) 2px no-repeat,
                linear-gradient(var(--dark) 0 0) bottom / calc(100% - 2 * max(16px, env(safe-area-inset-left, 0px))) 1px no-repeat;
  }

  .intro { display: flex; flex-direction: column; align-items: center; text-align: center; padding-block: clamp(56px, 8vw, 112px) clamp(56px, 7vw, 96px); }
  h1 { font: 400 var(--step-4)/0.95 var(--display); letter-spacing: -0.03em; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.3em 0.22em; }
  h1 em { font-style: italic; color: var(--accent); padding-inline: 0.06em; }
  h1 .size { font-size: 0.75rem; }

  .lead { margin: 48px auto 0; max-width: 40ch; font-size: clamp(1.3rem, 2.2vw, 1.6rem); line-height: 1.5; color: var(--dark); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 20px; margin-top: 40px; }
  .hint { margin-top: 28px; color: var(--on-light-muted); font: italic 0.95rem var(--serif); }

  .shot { margin: 0; padding-bottom: clamp(32px, 5vw, 64px); background: var(--light); }
  .shot :global(img) { width: 100%; }
  figcaption { margin-top: 14px; font: 500 0.7rem/1.4 var(--mono); letter-spacing: 0.2em; text-transform: uppercase; color: var(--on-light-muted); }

  .hero :global(.selection.live) { position: absolute; z-index: 5; pointer-events: none; background: rgb(242 88 42 / 0.06); }
  .hero :global(.try) { pointer-events: auto; position: absolute; left: -1px; top: calc(100% + 32px); padding: 6px 10px; background: var(--dark); color: var(--white); font: 500 0.75rem/1 var(--mono); text-decoration: none; white-space: nowrap; }
  .hero :global(.try:hover) { background: var(--accent); }

  @media (max-width: 900px) {
    .optional { display: none; }
    .hint { display: none; }
  }
</style>
