---
import { Image } from 'astro:assets';
import classic from '../assets/layout-classic.png';
import twoRows from '../assets/layout-two-rows.png';
import sidebars from '../assets/layout-sidebars.png';
import canvasFirst from '../assets/layout-canvas-first.png';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale).layouts;
// Same order as t.layouts.items.
const images = [classic, twoRows, sidebars, canvasFirst];
---
<section class="band" id="layouts">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>

    <!-- Tabs without JavaScript: each radio button shows the panel with the same index. -->
    <div class="tabs">
      <div class="tablist">
        {t.items.map(([name], i) => (
          <label>
            <input type="radio" name="layout" value={i} checked={i === 0} />
            <span>{name}</span>
          </label>
        ))}
      </div>
      {t.items.map(([name, text], i) => (
        <figure class="panel" data-index={i}>
          <div class="viewfinder">
            <Image src={images[i]} alt={`${name}: ${text}`} widths={[640, 1200]} sizes="(min-width: 1200px) 1130px, 100vw" />
          </div>
          <figcaption>{text}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .tabs { margin-top: 48px; }
  .tablist { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 28px; }
  label { cursor: pointer; }
  input { position: absolute; opacity: 0; pointer-events: none; }
  label span { display: block; padding: 11px 18px; font-weight: 600; background: var(--tile); }
  label:hover span { background: var(--tile-strong); }
  input:checked + span { background: var(--white); color: var(--night); }
  input:focus-visible + span { outline: 2px solid var(--white); outline-offset: 2px; }

  .panel { display: none; margin: 0; }
  .tabs:has(input[value='0']:checked) .panel[data-index='0'],
  .tabs:has(input[value='1']:checked) .panel[data-index='1'],
  .tabs:has(input[value='2']:checked) .panel[data-index='2'],
  .tabs:has(input[value='3']:checked) .panel[data-index='3'] { display: block; }
  .panel :global(img) { width: 100%; }
  figcaption { margin-top: 14px; color: var(--on-dark-muted); max-width: 60ch; }
</style>
