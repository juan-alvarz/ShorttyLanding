---
import { REPO, RELEASES } from '../config';
import { useTranslations } from '../i18n';
import { toAscii } from '../lib/ascii';

const t = useTranslations(Astro.currentLocale).footer;
const cat = await toAscii('public/icon.svg', 64, 30);
---
<footer class="band">
  <div class="wrap grid">
    <pre aria-hidden="true">{cat}</pre>
    <div class="text">
      <p class="name">shortty</p>
      <p>{t.tagline}</p>
      <p>{t.license}</p>
      <ul>
        <li><a href={REPO}>{t.source}</a></li>
        <li><a href={RELEASES}>{t.releases}</a></li>
        <li><a href={`${REPO}/issues`}>{t.issues}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  footer { padding-block: 64px 80px; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; gap: 24px; }
  pre { margin: 0; color: #d4d4d4; font-size: 5px; line-height: 1.1; }
  .text { display: grid; gap: 4px; color: var(--on-light-muted); font-size: 0.9rem; }
  .name { font: 600 1rem/1 var(--display); color: var(--dark); margin-bottom: 8px; }
  ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 24px; list-style: none; margin: 14px 0 0; padding: 0; }
</style>
