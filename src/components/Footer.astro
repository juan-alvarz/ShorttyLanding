---
import { REPO, LICENSE } from '../config';
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).footer;
---
<footer>
  <div class="wrap">
    <p>{t.license} <a href={LICENSE}>{t.licenseLink}</a>.</p>
    <p><a href={REPO}>{t.source}</a> · <a href={`${REPO}/issues`}>{t.issues}</a></p>
  </div>
</footer>

<style>
  footer { background: var(--bg-alt); padding: 48px 0; color: var(--muted); font: 0.9rem var(--mono); }
  footer p { margin: 0 0 0.5em; }
</style>
