---
import { REPO, RELEASES } from '../config';
import { useTranslations } from '../i18n';
import { toAscii } from '../lib/ascii';

const t = useTranslations(Astro.currentLocale).footer;
const cat = await toAscii('public/icon.svg', 64, 30);
---
<footer class="band">
  <div class="wrap grid">
    <pre aria-hidden="true">{cat}</pre>
    <div class="text">
      <p class="name">shortty</p>
      <p>{t.tagline}</p>
      <p>{t.license}</p>
      <ul>
        <li><a href={REPO}>{t.source}</a></li>
        <li><a href={RELEASES}>{t.releases}</a></li>
        <li><a href={`${REPO}/issues`}>{t.issues}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .grid { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: end; gap: 48px; }
  pre { margin: 0; color: var(--white); font-size: clamp(6px, 1.2vw, 12px); line-height: 1.1; font-weight: 500; }
  .text { display: grid; gap: 6px; color: var(--on-dark-muted); }
  .name { font: 800 var(--step-3)/1 var(--display); letter-spacing: -0.06em; color: var(--white); margin-bottom: 12px; }
  ul { display: flex; flex-wrap: wrap; gap: 24px; list-style: none; margin: 18px 0 0; padding: 0; }

  @media (max-width: 700px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
