---
import { REPO, RELEASES } from '../config';
import { useTranslations } from '../i18n';
import { toAscii } from '../lib/ascii';

const t = useTranslations(Astro.currentLocale).footer;
const cat = await toAscii('public/icon.svg', 64, 30);
---
<footer class="band light">
  <div class="wrap grid">
    <pre aria-hidden="true">{cat}</pre>
    <div class="text">
      <p class="name">shortty</p>
      <p>{t.tagline}</p>
      <p>{t.license}</p>
      <ul>
        <li><a href={REPO}>{t.source}</a></li>
        <li><a href={RELEASES}>{t.releases}</a></li>
        <li><a href={`${REPO}/issues`}>{t.issues}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  footer { padding-block: 72px; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); align-items: end; gap: clamp(40px, 5vw, 80px); }
  pre { margin: 0; color: var(--accent); font-size: clamp(6px, 1.1vw, 11px); line-height: 1.1; font-weight: 600; }
  .text { display: grid; gap: 6px; color: var(--on-light-muted); }
  .name { font: 900 var(--step-4)/0.8 var(--display); letter-spacing: -0.07em; color: var(--dark); margin-bottom: 20px; }
  ul { display: flex; flex-wrap: wrap; gap: 24px; list-style: none; margin: 18px 0 0; padding: 0; font-weight: 700; text-transform: lowercase; }
  a { color: var(--dark); }
  a:hover { color: var(--accent); }

  @media (max-width: 700px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
