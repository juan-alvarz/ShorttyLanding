---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).capture;
---
<section class="band light" id="capture">
  <div class="wrap grid">
    <div class="intro">
      <span class="label">{t.label}</span>
      <h2>{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>
    <dl>
      {t.items.map(([name, text]) => (
        <div>
          <dt>{name}</dt>
          <dd>{text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: clamp(40px, 5vw, 80px); }
  .intro { position: sticky; top: 24px; align-self: start; }
  dl { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 40px; }
  dl > div { display: grid; gap: 6px; }
  dt { font: 900 var(--step-2)/1 var(--display); letter-spacing: -0.03em; text-transform: lowercase; }
  dl > div:hover dt { color: var(--accent); }
  dd { margin: 0; color: var(--on-light-muted); }

  @media (max-width: 960px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .intro { position: static; }
  }
  @media (max-width: 520px) { dl { grid-template-columns: minmax(0, 1fr); gap: 28px; } }
</style>
