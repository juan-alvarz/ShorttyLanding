---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).capture;
---
<section class="band dark" id="capture">
  <div class="wrap grid">
    <div class="intro">
      <span class="label">{t.label}</span>
      <h2>{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>
    <dl>
      {t.items.map(([name, text]) => (
        <div>
          <dt>{name}</dt>
          <dd>{text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 64px; }
  .intro { position: sticky; top: 32px; align-self: start; }
  dl { margin: 0; display: grid; gap: 0; counter-reset: part; }
  dl > div { counter-increment: part; display: grid; grid-template-columns: 3.2rem 12rem minmax(0, 1fr); gap: 16px; align-items: baseline; padding: 12px 0; background: linear-gradient(90deg, var(--blue-700) 60%, transparent 0) bottom / 8px 1px repeat-x; }
  dl > div::before { content: 'A' counter(part, decimal-leading-zero); font: 500 0.95rem var(--display); letter-spacing: 0.1em; color: var(--blue-300); }
  dt { font: 700 1.35rem/1 var(--display); text-transform: uppercase; }
  dd { margin: 0; color: var(--blue-200); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .intro { position: static; }
  }
  @media (max-width: 560px) { dl > div { grid-template-columns: 3.2rem minmax(0, 1fr); } dd { grid-column: 2; } }
</style>
