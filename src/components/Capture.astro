---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).capture;
---
<section class="band light" id="capture">
  <div class="wrap grid">
    <div class="intro">
      <span class="label">{t.label}</span>
      <h2>{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>
    <dl>
      {t.items.map(([name, text]) => (
        <div>
          <dt>{name}</dt>
          <dd>{text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 72px; }
  .intro { position: sticky; top: 32px; align-self: start; }
  dl { margin: 0; columns: 2; column-gap: 48px; }
  dl > div { break-inside: avoid; padding-bottom: 22px; }
  dt { font: italic 400 1.5rem/1.1 var(--display); margin-bottom: 6px; }
  dd { margin: 0; color: var(--on-light-muted); font-size: 1rem; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 48px; }
    .intro { position: static; }
  }
  @media (max-width: 560px) { dl { columns: 1; } }
</style>
