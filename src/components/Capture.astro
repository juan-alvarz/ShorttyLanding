---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).capture;
---
<section class="band light" id="capture">
  <div class="wrap grid">
    <div class="intro">
      <span class="label">{t.label}</span>
      <h2>{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>
    <dl>
      {t.items.map(([name, text]) => (
        <div>
          <dt>{name}</dt>
          <dd>{text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 64px; }
  .intro { position: sticky; top: calc(var(--nav-h, 76px) + 32px); align-self: start; }
  dl { margin: 0; display: grid; gap: 0; counter-reset: fig; }
  dl > div {
    counter-increment: fig;
    display: grid;
    grid-template-columns: 4ch 15ch minmax(0, 1fr);
    gap: 16px;
    padding: 14px 0;
    background: linear-gradient(90deg, var(--dark) 50%, transparent 0) bottom / 6px 1px repeat-x;
  }
  dl > div::before { content: counter(fig, decimal-leading-zero); color: var(--accent); }
  dl > div:hover { background-color: var(--light-raised); }
  dt { font-weight: 600; }
  dd { margin: 0; color: var(--on-light-muted); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .intro { position: static; }
  }
  @media (max-width: 560px) {
    dl > div { grid-template-columns: 4ch minmax(0, 1fr); }
    dd { grid-column: 2; }
  }
</style>
