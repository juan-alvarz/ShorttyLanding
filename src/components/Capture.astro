---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).capture;
---
<section class="band light" id="capture">
  <div class="wrap grid">
    <div class="intro">
      <span class="label">{t.label}</span>
      <h2>{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>
    <dl>
      {t.items.map(([name, text]) => (
        <div>
          <dt>{name}</dt>
          <dd>{text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 56px; }
  dl { margin: 0; display: grid; gap: 4px; }
  dl > div { display: grid; grid-template-columns: 12ch minmax(0, 1fr); gap: 24px; padding: 14px 18px; background: var(--glass-strong); }
  dl > div:hover { background: var(--white); }
  dt { font: 700 1.05rem/1.4 var(--display); }
  dd { margin: 0; color: var(--on-light-muted); }

  @media (max-width: 900px) { .grid { grid-template-columns: minmax(0, 1fr); gap: 40px; } }
  @media (max-width: 520px) { dl > div { grid-template-columns: minmax(0, 1fr); gap: 2px; } }
</style>
