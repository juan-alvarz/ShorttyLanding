---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).capture;
---
<section class="band paper" id="capture">
  <div class="wrap grid">
    <div class="intro">
      <span class="label">{t.label}</span>
      <h2>{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>
    <dl>
      {t.items.map(([name, text]) => (
        <div>
          <dt>{name}</dt>
          <dd>{text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 64px; }
  .intro { position: sticky; top: 32px; align-self: start; }
  dl { margin: 0; display: grid; gap: 4px; }
  dl { gap: 0; }
  dl > div {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 24px;
    padding: 18px 0;
  }
  dl > div:nth-child(odd) { background: linear-gradient(90deg, var(--paper-raised), transparent); padding-left: 16px; margin-left: -16px; }
  dt { font-weight: 800; font-size: 1.15rem; letter-spacing: -0.01em; }
  dl > div:hover dt { color: var(--cobalt); }
  dd { margin: 0; color: var(--on-paper-muted); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .intro { position: static; }
  }
  @media (max-width: 520px) {
    dl > div { grid-template-columns: minmax(0, 1fr); gap: 4px; }
  }
</style>
