---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).capture;
---
<section class="band light" id="capture">
  <div class="wrap grid">
    <div class="intro">
      <span class="label">{t.label}</span>
      <h2>{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>
    <dl>
      {t.items.map(([name, text]) => (
        <div>
          <dt>{name}</dt>
          <dd>{text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 64px; }
  .intro { position: sticky; top: 32px; align-self: start; }
  dl { margin: 0; display: grid; gap: 0; }
  dl > div { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 24px; align-items: baseline; padding: 12px 0; }
  dt { font: 800 1.7rem/1 var(--display); text-transform: uppercase; }
  dl > div:hover dt { color: var(--accent); }
  dd { margin: 0; color: var(--on-light-muted); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .intro { position: static; }
  }
  @media (max-width: 560px) { dl > div { grid-template-columns: minmax(0, 1fr); gap: 2px; } }
</style>
