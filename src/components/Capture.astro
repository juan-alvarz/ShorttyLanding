---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).capture;
---
<section class="band light" id="capture">
  <div class="wrap grid">
    <div class="intro">
      <span class="label">{t.label}</span>
      <h2>{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>
    <dl>
      {t.items.map(([name, text]) => (
        <div>
          <dt>{name}</dt>
          <dd>{text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 64px; }
  .intro { position: sticky; top: 32px; align-self: start; }
  dl { margin: 0; display: grid; gap: 0; }
  dl::before { content: 'shortty capture'; color: var(--accent); margin-bottom: 8px; }
  dl > div {
    display: grid;
    grid-template-columns: 4ch 19ch minmax(0, 1fr);
    gap: 0 12px;
    padding: 6px 0;
  }
  dl > div::before { content: '├──'; grid-row: 1 / 3; color: var(--on-dark-muted); }
  dl > div:last-child::before { content: '└──'; }
  dl > div:hover dt { color: var(--accent); }
  dt { font-weight: 600; }
  dd { margin: 0; color: var(--on-dark-muted); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .intro { position: static; }
  }
  @media (max-width: 620px) {
    dl > div { grid-template-columns: 4ch minmax(0, 1fr); }
    dd { grid-column: 2; }
  }
</style>
