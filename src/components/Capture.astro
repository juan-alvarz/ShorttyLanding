---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).capture;
---
<section class="band" id="capture">
  <div class="wrap grid">
    <div class="intro">
      <span class="label">{t.label}</span>
      <h2>{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>
    <dl>
      {t.items.map(([name, text]) => (
        <div>
          <dt>{name}</dt>
          <dd>{text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 80px; }
  dl { margin: 0; display: grid; gap: 22px; }
  dl > div { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 24px; }
  dt { font-weight: 600; }
  dd { margin: 0; color: var(--on-light-muted); }

  @media (max-width: 860px) { .grid { grid-template-columns: minmax(0, 1fr); gap: 48px; } }
  @media (max-width: 520px) { dl > div { grid-template-columns: minmax(0, 1fr); gap: 2px; } }
</style>
