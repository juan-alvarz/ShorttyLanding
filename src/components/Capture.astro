---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).capture;
---
<section class="band light" id="capture">
  <div class="wrap grid">
    <div class="intro">
      <span class="label">{t.label}</span>
      <h2>{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>
    <dl>
      {t.items.map(([name, text]) => (
        <div>
          <dt>{name}</dt>
          <dd>{text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 64px; }
  .intro { position: sticky; top: 32px; align-self: start; }
  dl { margin: 0; display: grid; gap: 8px; }
  dl > div { display: grid; grid-template-columns: 13ch minmax(0, 1fr); gap: 20px; padding: 14px 18px; background: var(--white); box-shadow: 4px 4px 0 var(--p8-navy); }
  dl > div:hover { background: var(--p8-yellow); }
  dt { font: 700 1.15rem/1.3 var(--display); }
  dd { margin: 0; color: var(--on-light-muted); }
  dl > div:hover dd { color: var(--p8-navy); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .intro { position: static; }
  }
  @media (max-width: 520px) { dl > div { grid-template-columns: minmax(0, 1fr); gap: 2px; } }
</style>
