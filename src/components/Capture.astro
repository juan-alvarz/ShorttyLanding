---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).capture;
---
<section class="band light" id="capture">
  <div class="wrap grid">
    <div class="intro">
      <span class="label">{t.label}</span>
      <h2>{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>
    <dl>
      {t.items.map(([name, text]) => (
        <div>
          <dt>{name}</dt>
          <dd>{text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 64px; }
  .intro { position: sticky; top: calc(var(--nav-h, 76px) + 32px); align-self: start; }
  dl { margin: 0; display: grid; gap: 4px; }
  dl > div {
    display: grid;
    grid-template-columns: 13ch minmax(0, 1fr);
    gap: 24px;
    padding: 18px 20px;
    background: var(--light-raised);
    box-shadow: inset 6px 0 0 var(--primary);
  }
  dl > div:hover { background: var(--primary); }
  dl > div:hover dd { color: var(--on-primary); }
  dt { font-weight: 600; }
  dd { margin: 0; color: var(--on-light-muted); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .intro { position: static; }
  }
  @media (max-width: 520px) {
    dl > div { grid-template-columns: minmax(0, 1fr); gap: 4px; }
  }
</style>
