---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).capture;
---
<section class="band light" id="capture">
  <div class="wrap grid">
    <div class="intro">
      <span class="label">{t.label}</span>
      <h2>{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>
    <dl>
      {t.items.map(([name, text]) => (
        <div>
          <dt>{name}</dt>
          <dd>{text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 64px; }
  .intro { position: sticky; top: calc(var(--nav-h, 76px) + 40px); align-self: start; }
  dl { margin: 0; display: grid; gap: 6px; }
  dl > div { display: grid; grid-template-columns: 12ch minmax(0, 1fr); gap: 24px; padding: 16px 20px; background: var(--white); }
  dl > div:hover { background: var(--dark); color: var(--white); }
  dl > div:hover dd { color: var(--on-dark-muted); }
  dt { font: 400 1.25rem/1.2 var(--display); }
  dd { margin: 0; color: var(--on-light-muted); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .intro { position: static; }
  }
  @media (max-width: 520px) { dl > div { grid-template-columns: minmax(0, 1fr); gap: 2px; } }
</style>
