---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).features;
---
<section id="features">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>
    <ul class="grid">
      {t.items.map(([title, text], i) => (
        <li>
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid { list-style: none; margin: 56px 0 0; padding: 0; display: grid; gap: 4px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  li { background: var(--panel); padding: 28px; }
  li:hover { background: var(--accent); color: var(--accent-text); }
  li:hover p, li:hover .n { color: var(--accent-text); }
  .n { font: 600 0.8rem var(--mono); color: var(--accent); letter-spacing: 0.1em; }
  li h3 { margin-top: 28px; }
  li p { color: var(--muted); margin: 0; }
</style>
