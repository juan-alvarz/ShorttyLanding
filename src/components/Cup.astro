---
// The footer's coffee cup, heat style: a chunky dark mug, tilted, with a hard blue shadow.
// It stands up straight on hover, like the hero screenshot.
---
<svg class="cup" viewBox="0 0 72 72" aria-hidden="true">
  <g class="steam">
    <path d="M27 20c-4-4 4-7 0-12" />
    <path d="M38 20c-4-4 4-7 0-12" />
  </g>
  <g class="mug">
    <path class="shadow" d="M18 30h36v22c0 6-4 10-10 10H28c-6 0-10-4-10-10zM54 34h6c4 0 6 3 6 7s-2 7-6 7h-6v-5h5c1.5 0 2-1 2-2s-.5-2-2-2h-5z" transform="translate(4 4)" />
    <path class="body" d="M14 26h36v22c0 6-4 10-10 10H24c-6 0-10-4-10-10zM50 30h6c4 0 6 3 6 7s-2 7-6 7h-6v-5h5c1.5 0 2-1 2-2s-.5-2-2-2h-5z" />
    <path class="band" d="M14 33h36v5H14z" />
  </g>
</svg>

<style>
  .cup { width: 60px; height: 60px; flex: none; overflow: visible; }
  .mug { transform: rotate(-8deg); transform-origin: 36px 44px; transition: transform 0.4s cubic-bezier(.2,.8,.2,1); }
  .shadow { fill: var(--accent); }
  .body { fill: var(--dark); }
  .band { fill: var(--primary); }
  .steam path { fill: none; stroke: var(--dark); stroke-width: 4; stroke-linecap: round; }

  :global(a:hover) > .cup .mug, :global(a:focus-visible) > .cup .mug { transform: rotate(0deg); }
  @media (prefers-reduced-motion: no-preference) {
    :global(a:hover) > .cup .steam path,
    :global(a:focus-visible) > .cup .steam path { animation: rise 1.1s ease-in infinite; }
    .steam path:nth-child(2) { animation-delay: 0.35s !important; }
  }
  @media (prefers-reduced-motion: reduce) { .mug { transition: none; } }
  @keyframes rise {
    from { transform: translateY(4px); opacity: 0; }
    40% { opacity: 1; }
    to { transform: translateY(-6px); opacity: 0; }
  }
</style>
