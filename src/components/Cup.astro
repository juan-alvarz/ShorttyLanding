---
// The footer's coffee cup, minimal style: one thin line, and the page's one orange as a single
// dot of steam that drifts up on hover.
---
<svg class="cup" viewBox="0 0 24 24" aria-hidden="true">
  <rect class="steam" x="9.5" y="2" width="3" height="3" />
  <path d="M4 9h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5zM17 11h2a2 2 0 0 1 0 4h-2" />
</svg>

<style>
  .cup { width: 22px; height: 22px; flex: none; fill: none; stroke: var(--dark); stroke-width: 1.4; }
  .steam { fill: var(--accent); stroke: none; }
  @media (prefers-reduced-motion: no-preference) {
    :global(a:hover) > .cup .steam, :global(a:focus-visible) > .cup .steam { animation: drift 1.6s ease-in-out infinite; }
  }
  @keyframes drift {
    from { transform: translateY(3px); opacity: 0; }
    40% { opacity: 1; }
    to { transform: translateY(-3px); opacity: 0; }
  }
</style>
