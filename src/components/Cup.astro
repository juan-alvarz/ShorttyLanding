---
// The footer's coffee cup. Each design draws its own; this one is framed by the viewfinder's corners.
---
<svg class="cup" viewBox="0 0 64 64" aria-hidden="true">
  <g class="corners">
    <path d="M3 14V3h11M50 3h11v11M61 50v11H50M14 61H3V50" />
  </g>
  <g class="steam">
    <path d="M23 24c-3-3 3-5 0-9" />
    <path d="M30 24c-3-3 3-5 0-9" />
    <path d="M37 24c-3-3 3-5 0-9" />
  </g>
  <path d="M15 29h28l-3 20H18zM43 33h6v9h-7.5M11 54h36" />
</svg>

<style>
  .cup { width: 52px; height: 52px; flex: none; fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: square; }
  .corners { stroke: var(--accent); stroke-width: 2.5; }
  .steam path { stroke-width: 2.5; opacity: 0.7; }

  @media (prefers-reduced-motion: no-preference) {
    :global(a:hover) > .cup .steam path,
    :global(a:focus-visible) > .cup .steam path { animation: rise 1.4s ease-in infinite; }
    .steam path:nth-child(2) { animation-delay: 0.25s !important; }
    .steam path:nth-child(3) { animation-delay: 0.5s !important; }
  }
  @keyframes rise {
    from { transform: translateY(3px); opacity: 0; }
    40% { opacity: 0.8; }
    to { transform: translateY(-5px); opacity: 0; }
  }
</style>
