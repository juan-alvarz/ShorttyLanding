---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).extras;
---
<section class="band light">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <ul>
      {t.items.map(([name, text]) => (
        <li>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px; list-style: none; margin: 64px 0 0; padding: 0; }
  h3 { margin-bottom: 12px; font-size: clamp(2rem, 3.6vw, 2.8rem); }
  li:hover h3 { color: var(--accent); }
  p { color: var(--on-light-muted); max-width: 40ch; }

  @media (max-width: 900px) { ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { ul { grid-template-columns: minmax(0, 1fr); gap: 36px; } }
</style>
