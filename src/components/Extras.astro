---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).extras;
---
<section class="band plum">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <ul>
      {t.items.map(([name, text]) => (
        <li>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; list-style: none; margin: 56px 0 0; padding: 0; }
  li { padding: 24px; background: var(--p8-navy); box-shadow: 4px 4px 0 var(--p8-black); }
  li::before { content: 'POWER-UP'; display: block; margin-bottom: 14px; font: 400 0.7rem/1 var(--pixel); color: var(--p8-yellow); }
  h3 { margin-bottom: 10px; }
  p { color: var(--on-dark-muted); max-width: 40ch; }

  @media (max-width: 900px) { ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { ul { grid-template-columns: minmax(0, 1fr); } }
</style>
