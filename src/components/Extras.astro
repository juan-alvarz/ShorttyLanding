---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).extras;
---
<section class="band primary">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <ul>
      {t.items.map(([name, text]) => (
        <li>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 40px; list-style: none; margin: 48px 0 0; padding: 0; }
  h3 { font: 900 var(--step-2)/1 var(--display); letter-spacing: -0.03em; text-transform: lowercase; margin-bottom: 10px; }
  p { color: var(--on-primary-muted); max-width: 40ch; }

  @media (max-width: 560px) { ul { grid-template-columns: minmax(0, 1fr); } }
</style>
