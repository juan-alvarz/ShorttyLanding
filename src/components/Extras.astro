---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).extras;
---
<section class="band raised">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <ul>
      {t.items.map(([name, text]) => (
        <li>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 56px 48px; list-style: none; margin: 64px 0 0; padding: 0; }
  h3 { font: 900 var(--step-2)/1.05 var(--display); letter-spacing: -0.03em; margin-bottom: 12px; }
  li:nth-child(3n + 1) h3 { color: var(--accent); }
  li:nth-child(3n + 2) h3 { color: var(--sun); }
  p { color: var(--on-dark-muted); max-width: 40ch; }

  @media (max-width: 1000px) { ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { ul { grid-template-columns: minmax(0, 1fr); gap: 40px; } }
</style>
