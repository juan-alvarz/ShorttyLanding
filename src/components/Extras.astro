---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).extras;
---
<section class="band primary">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <ul>
      {t.items.map(([name, text]) => (
        <li>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px 6px; list-style: none; margin: 80px 0 0; padding: 0; }
  li { position: relative; padding: 28px 26px; background: var(--light); }
  li::before, li::after { content: ''; position: absolute; top: -22px; width: 28px; height: 26px; background: var(--light); }
  li::before { left: 18px; clip-path: polygon(0 100%, 28% 0, 100% 100%); }
  li::after { right: 18px; clip-path: polygon(0 100%, 72% 0, 100% 100%); }
  h3 { font: 400 var(--step-2)/1.05 var(--display); margin-bottom: 12px; }
  p { color: var(--on-light-muted); max-width: 40ch; }

  @media (max-width: 900px) { ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { ul { grid-template-columns: minmax(0, 1fr); } }
</style>
