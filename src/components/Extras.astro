---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).extras;
---
<section class="band butter">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <ul>
      {t.items.map(([name, text]) => (
        <li>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; list-style: none; margin: 64px 0 0; padding: 0; }
  li { padding: 28px; background: var(--white); }
  li:nth-child(6n + 1) { background: var(--lilac); }
  li:nth-child(6n + 2) { background: var(--mint); }
  li:nth-child(6n + 3) { background: var(--peach); }
  li:nth-child(6n + 4) { background: var(--sky); }
  li:nth-child(6n + 5) { background: var(--white); }
  li:nth-child(6n + 6) { background: var(--dark); color: var(--white); }
  li:nth-child(6n + 6) p { color: var(--on-dark-muted); }
  h3 { font: 400 var(--step-2)/1.1 var(--display); margin-bottom: 14px; }
  p { color: var(--on-light-muted); max-width: 40ch; }

  @media (max-width: 900px) { ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { ul { grid-template-columns: minmax(0, 1fr); } }
</style>
