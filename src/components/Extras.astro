---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).extras;
---
<section class="band dark">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <ul>
      {t.items.map(([name, text]) => (
        <li>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px 80px; list-style: none; margin: 80px 0 0; padding: 0; }
  h3 { font: italic 400 var(--step-2)/1.1 var(--display); margin-bottom: 14px; color: var(--white); }
  p { color: var(--on-dark-muted); max-width: 46ch; }
  li:first-child { grid-column: 1 / -1; }
  li:first-child h3 { font-size: var(--step-3); }
  li:first-child p { font-size: var(--step-1); font-style: italic; max-width: 52ch; color: var(--white); }

  @media (max-width: 700px) { ul { grid-template-columns: minmax(0, 1fr); gap: 48px; } }
</style>
