---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).edit;
---
<section class="band dark" id="edit">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>
    <ul>
      {t.tools.map(([keys, name, text]) => (
        <li>
          <span class="keys">{keys.split(' ').map((key) => <kbd>{key}</kbd>)}</span>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  ul { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; list-style: none; margin: 64px 0 0; padding: 0; }
  li { display: grid; grid-template-rows: auto auto 1fr; gap: 8px; padding: 22px; background: var(--dark-raised); }
  .keys { display: flex; gap: 4px; }
  kbd { display: grid; place-items: center; min-width: 48px; height: 48px; padding-inline: 8px; background: var(--accent); color: var(--dark); font: 900 1.8rem/1 var(--display); }
  li:hover { background: var(--accent); color: var(--dark); }
  li:hover kbd { background: var(--dark); color: var(--accent); }
  li:hover p { color: var(--dark); }
  h3 { font-size: 1.6rem; }
  p { color: var(--on-dark-muted); font-size: 0.88rem; }

  @media (max-width: 900px) { ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { ul { grid-template-columns: minmax(0, 1fr); } }
</style>
