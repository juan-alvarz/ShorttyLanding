---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).edit;
---
<section class="band dark" id="edit">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>
    <ul>
      {t.tools.map(([keys, name, text]) => (
        <li>
          <span class="keys">{keys.split(' ').map((key) => <kbd>{key}</kbd>)}</span>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 32px; list-style: none; margin: 48px 0 0; padding: 0; }
  li { display: grid; gap: 6px; }
  .keys { display: flex; gap: 6px; }
  kbd { font: 900 var(--step-3)/1 var(--display); color: var(--accent); }
  h3 { font: 700 1.1rem/1.2 var(--display); text-transform: lowercase; }
  p { color: var(--on-dark-muted); font-size: 0.92rem; }

  @media (max-width: 700px) { ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
