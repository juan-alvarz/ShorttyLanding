---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).edit;
---
<section class="band raised" id="edit">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>
    <ul>
      {t.tools.map(([keys, name, text]) => (
        <li>
          <span class="keys">{keys.split(' ').map((key) => <kbd>{key}</kbd>)}</span>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  ul { display: flex; flex-wrap: wrap; gap: 4px; list-style: none; margin: 64px 0 0; padding: 0; }
  li {
    flex: 1 1 250px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    column-gap: 18px;
    row-gap: 4px;
    padding: 20px;
    background: rgb(255 255 255 / 0.03);
  }
  .keys { grid-row: span 2; display: flex; gap: 4px; }
  kbd {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: #0b0b0e;
    color: var(--accent);
    font: 500 1.1rem/1 var(--mono);
    text-shadow: var(--neon);
    box-shadow: inset 0 0 0 1px rgb(255 122 69 / 0.25), 0 0 16px rgb(255 122 69 / 0.15);
  }
  li:hover kbd { color: var(--white); box-shadow: inset 0 0 0 1px var(--accent), 0 0 22px rgb(255 122 69 / 0.5); }
  p { color: var(--on-dark-muted); font-size: 0.9rem; }
</style>
