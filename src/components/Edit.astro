---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).edit;
---
<section class="band peach" id="edit">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>
    <ul>
      {t.tools.map(([keys, name, text]) => (
        <li>
          <span class="keys">{keys.split(' ').map((key) => <kbd>{key}</kbd>)}</span>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  ul { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; list-style: none; margin: 64px 0 0; padding: 0; }
  li {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 6px;
    padding: 20px;
    background: var(--white);
  }
  .keys { display: flex; gap: 4px; margin-bottom: 12px; }
  kbd {
    display: grid;
    place-items: center;
    min-width: 40px;
    height: 40px;
    padding-inline: 8px;
    background: var(--peach);
    color: var(--dark);
    font: 500 1rem/1 var(--mono);
    box-shadow: inset 0 -4px 0 rgb(34 29 58 / 0.15);
  }
  li:nth-child(4n + 2) kbd { background: var(--mint); }
  li:nth-child(4n + 3) kbd { background: var(--lilac); }
  li:nth-child(4n + 4) kbd { background: var(--sky); }
  li:hover { background: var(--dark); color: var(--white); }
  li:hover p { color: var(--on-dark-muted); }
  p { color: var(--on-light-muted); font-size: 0.92rem; }

  @media (max-width: 900px) { ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { ul { grid-template-columns: minmax(0, 1fr); } }
</style>
