---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).edit;
---
<section class="band raised" id="edit">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>
    <ul>
      {t.tools.map(([keys, name, text]) => (
        <li>
          <span class="keys">{keys.split(' ').map((key) => <kbd>{key}</kbd>)}</span>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; list-style: none; margin: 56px 0 0; padding: 0; }
  li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    column-gap: 16px;
    row-gap: 4px;
    padding: 18px;
    background: var(--white);
  }
  .keys { grid-row: span 2; display: flex; gap: 4px; }
  kbd {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    background: var(--dark);
    color: var(--white);
    font: 600 1rem/1 var(--mono);
    box-shadow: inset 0 -4px 0 var(--accent);
  }
  li:hover kbd { background: var(--accent); color: var(--dark); box-shadow: inset 0 -4px 0 var(--dark); }
  p { color: var(--on-light-muted); font-size: 0.88rem; }

  @container (max-width: 760px) { ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @container (max-width: 500px) { ul { grid-template-columns: minmax(0, 1fr); } }
</style>
