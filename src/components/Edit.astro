---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).edit;
---
<section class="band dark" id="edit">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>
    <ul>
      {t.tools.map(([keys, name, text]) => (
        <li>
          <span class="keys">{keys.split(' ').map((key) => <kbd>{key}</kbd>)}</span>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  ul { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px 6px; list-style: none; margin: 72px 0 0; padding: 0; }
  li { display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-rows: auto 1fr; column-gap: 16px; padding: 22px 18px 18px; background: var(--dark-raised); }
  .keys { grid-row: span 2; display: flex; gap: 6px; }
  kbd { position: relative; display: grid; place-items: center; width: 44px; height: 40px; margin-top: 6px; background: var(--accent); color: var(--dark); font: 400 1.4rem/1 var(--display); }
  kbd::before, kbd::after { content: ''; position: absolute; top: -9px; width: 12px; height: 11px; background: var(--accent); }
  kbd::before { left: 3px; clip-path: polygon(0 100%, 28% 0, 100% 100%); }
  kbd::after { right: 3px; clip-path: polygon(0 100%, 72% 0, 100% 100%); }
  li:hover kbd, li:hover kbd::before, li:hover kbd::after { background: var(--white); }
  p { color: var(--on-dark-muted); font-size: 0.92rem; }

  @media (max-width: 1000px) { ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { ul { grid-template-columns: minmax(0, 1fr); } }
</style>
