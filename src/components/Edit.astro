---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).edit;
---
<section class="band raised" id="edit">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>
    <ul>
      {t.tools.map(([keys, name, text]) => (
        <li>
          <span class="keys">{keys.split(' ').map((key) => <kbd>{key}</kbd>)}</span>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  ul { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; list-style: none; margin: 56px 0 0; padding: 0; }
  li { display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-rows: auto 1fr; column-gap: 14px; padding: 16px; background: var(--dark); }
  .keys { grid-row: span 2; display: flex; gap: 4px; }
  kbd { display: grid; place-items: center; width: 40px; height: 40px; background: var(--accent); color: var(--dark); font: 400 1.7rem/1 var(--display); text-shadow: none; box-shadow: 0 0 12px rgb(255 176 0 / 0.4); }
  li:hover kbd { background: var(--hot); }
  h3 { font-size: 1.6rem; }
  p { color: var(--on-dark-muted); font-size: 0.85rem; }

  @media (max-width: 1000px) { ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { ul { grid-template-columns: minmax(0, 1fr); } }
</style>
