---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).edit;
---
<section class="band dark" id="edit">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>
    <ul>
      {t.tools.map(([keys, name, text]) => (
        <li>
          <span class="keys">{keys.split(' ').map((key) => <kbd>{key}</kbd>)}</span>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 56px; list-style: none; margin: 56px 0 0; padding: 0; }
  li {
    display: grid;
    grid-template-columns: 8ch minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    column-gap: 16px;
    padding: 14px 0;
    box-shadow: inset 0 -1px 0 var(--light-raised);
  }
  .keys { grid-row: span 2; display: flex; gap: 6px; }
  kbd { font: 600 1rem/1.4 var(--mono); color: var(--accent); }
  kbd::before { content: '['; color: var(--on-dark-muted); }
  kbd::after { content: ']'; color: var(--on-dark-muted); }
  li:hover h3 { color: var(--accent); }
  p { color: var(--on-dark-muted); font-size: 0.88rem; }

  @media (max-width: 760px) { ul { grid-template-columns: minmax(0, 1fr); } }
</style>
