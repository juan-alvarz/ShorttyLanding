---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).edit;
---
<section class="band light" id="edit">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>
    <ul>
      {t.tools.map(([keys, name, text]) => (
        <li>
          <span class="keys">{keys.split(' ').map((key) => <kbd>{key}</kbd>)}</span>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  section { background: var(--light-raised); }
  ul { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px 28px; list-style: none; margin: 64px 0 0; padding: 0; }
  li { display: grid; gap: 8px; align-content: start; }
  .keys { display: flex; gap: 4px; }
  kbd { display: grid; place-items: center; width: 52px; height: 52px; background: var(--dark); color: var(--white); font: italic 400 1.9rem/1 var(--display); }
  li:hover kbd { background: var(--accent); }
  p { color: var(--on-light-muted); font-size: 0.85rem; }

  @media (max-width: 900px) { ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
