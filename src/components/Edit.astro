---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).edit;
---
<section class="band dark" id="edit">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>
    <ul>
      {t.tools.map(([keys, name, text]) => (
        <li>
          <span class="keys">{keys.split(' ').map((key) => <kbd>{key}</kbd>)}</span>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  ul { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; list-style: none; margin: 56px 0 0; padding: 0; }
  li { display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-rows: auto 1fr; column-gap: 16px; row-gap: 4px; padding: 20px; background: var(--dark-raised); }
  .keys { grid-row: span 2; display: flex; gap: 4px; }
  kbd { display: grid; place-items: center; width: 42px; height: 42px; background: var(--light); color: var(--dark); font: 900 1.15rem/1 var(--display); box-shadow: inset 0 -4px 0 var(--light-raised); }
  li:hover kbd { background: var(--accent); box-shadow: inset 0 -4px 0 rgb(0 0 0 / 0.2); }
  p { color: var(--on-dark-muted); font-size: 0.9rem; }

  @media (max-width: 1000px) { ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { ul { grid-template-columns: minmax(0, 1fr); } }
</style>
