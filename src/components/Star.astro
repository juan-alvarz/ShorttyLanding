---
import { REPO } from '../config';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale).star;
---
<section class="band dark" id="star">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>
    <a class="button" href={REPO}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" /></svg>
      {t.button}
    </a>
  </div>
</section>

<style>
  .button { margin-top: 48px; }
  svg { width: 18px; height: 18px; fill: currentColor; }
</style>
