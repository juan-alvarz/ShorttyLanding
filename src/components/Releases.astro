---
import { ALL_RELEASES } from '../config';
import { useTranslations } from '../i18n';
import { getReleases } from '../lib/releases';

const t = useTranslations(Astro.currentLocale);
const releases = await getReleases();
const formatDate = new Intl.DateTimeFormat(t.htmlLang, { dateStyle: 'medium', timeZone: 'UTC' });
---
<section class="band" id="releases">
  <div class="wrap">
    <span class="label">{t.releases.label}</span>
    <h2>{t.releases.title}</h2>
    <p class="lead">{t.releases.lead}</p>

    <!-- One open at a time (details with a shared name); the latest starts open. -->
    <div class="list">
      {releases.map((release, i) => (
        <details name="release" open={i === 0}>
          <summary>
            <span class="version">{release.name}</span>
            {release.date && <time datetime={release.date.toISOString()}>{formatDate.format(release.date)}</time>}
            {i === 0 && !release.prerelease && <span class="tag">{t.releases.latest}</span>}
            {release.prerelease && <span class="tag">{t.releases.prerelease}</span>}
          </summary>
          <div class="body">
            <div class="notes" set:html={release.notes} />
            <p class="links">
              {/* Labels name the version: six identical "Release on GitHub" links can't be told apart in a links list. */}
              {release.download && <a class="button" href={release.download.url} aria-label={`${t.releases.download} ${release.download.name}`}>{t.releases.download} {release.download.name} ↓</a>}
              <a class="button ghost" href={release.url} aria-label={`${t.releases.onGitHub}: ${release.name}`}>{t.releases.onGitHub} →</a>
            </p>
          </div>
        </details>
      ))}
    </div>
    <p class="all"><a href={ALL_RELEASES}>{t.releases.all} →</a></p>
  </div>
</section>

<style>
  .list { display: grid; gap: 4px; margin-top: 56px; }
  details { background: var(--tile); }
  summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 20px;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; margin-left: auto; font-weight: 600; }
  details[open] summary::after { content: '−'; }
  summary:hover { background: var(--tile-strong); }
  summary:focus-visible { outline: 2px solid var(--white); outline-offset: 2px; }
  .version { font: 800 var(--step-2)/1.1 var(--display); letter-spacing: -0.04em; }
  time { color: var(--on-light-muted); font-size: 0.85rem; }
  .tag { padding: 4px 8px; background: var(--white); color: var(--night); font: 600 0.72rem/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; }

  .body { padding: 4px 24px 28px; }
  .notes { max-width: 68ch; color: var(--on-light-muted); }
  .notes :global(:is(h1, h2, h3, h4)) { margin: 20px 0 8px; font: 600 0.78rem/1.3 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--white); }
  .notes :global(:is(p, ul, ol)) { margin: 0 0 12px; }
  .notes :global(:is(ul, ol)) { padding-left: 1.2em; }
  .notes :global(li::marker) { color: #ffe28c; }
  .notes :global(:is(strong, a, code)) { color: var(--white); }
  .notes :global(img) { margin-block: 12px; }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 20px; }

  .all { margin-top: 28px; }
  .all a:hover { text-decoration-thickness: 2px; }
</style>
