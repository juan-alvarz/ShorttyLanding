---
import { ALL_RELEASES } from '../config';
import { useTranslations } from '../i18n';
import { API, LIMIT, getReleases } from '../lib/releases';

const t = useTranslations(Astro.currentLocale);
const releases = await getReleases();
const formatDate = new Intl.DateTimeFormat(t.htmlLang, { dateStyle: 'medium', timeZone: 'UTC' });
---
<section class="band light" id="releases">
  <div class="wrap">
    <span class="label">{t.releases.label}</span>
    <h2>{t.releases.title}</h2>
    <p class="lead">{t.releases.lead}</p>

    <!-- One open at a time (details with a shared name); the latest starts open. Built from GitHub at
         build time, then refreshed in the browser (src/scripts/releases.ts). -->
    <div class="list" data-accordion data-releases={API} data-limit={LIMIT} data-lang={t.htmlLang}>
      {releases.map((release, i) => (
        <details name="release" open={i === 0} data-tag={release.tag}>
          <summary>
            <span class="version">{release.name}</span>
            {release.date && <time datetime={release.date.toISOString()}>{formatDate.format(release.date)}</time>}
            {i === 0 && !release.prerelease && <span class="tag">{t.releases.latest}</span>}
            {release.prerelease && <span class="tag">{t.releases.prerelease}</span>}
          </summary>
          <div class="body">
            <div class="notes" set:html={release.notes} />
            <p class="links">
              {/* Labels name the version: six identical "Release on GitHub" links can't be told apart in a links list. */}
              {release.download && <a class="button" href={release.download.url} aria-label={`${t.releases.download} ${release.download.name}`}>{t.releases.download} {release.download.name} ↓</a>}
              <a class="button ghost" href={release.url} aria-label={`${t.releases.onGitHub}: ${release.name}`}>{t.releases.onGitHub} →</a>
            </p>
          </div>
        </details>
      ))}
    </div>
    <!-- One release, empty: the browser fills copies of it with newer releases. -->
    <template data-release-template>
      <details name="release">
        <summary>
          <span class="version"></span>
          <time></time>
          <span class="tag" data-latest>{t.releases.latest}</span>
          <span class="tag" data-prerelease>{t.releases.prerelease}</span>
        </summary>
        <div class="body">
          <div class="notes"></div>
          <p class="links">
            <a class="button" data-download data-label={t.releases.download}></a>
            <a class="button ghost" data-github data-label={t.releases.onGitHub}>{t.releases.onGitHub} →</a>
          </p>
        </div>
      </details>
    </template>
    <p class="all"><a href={ALL_RELEASES}>{t.releases.all} →</a></p>
  </div>
</section>

<script>
  import '../scripts/accordion';
  import '../scripts/releases';
</script>

<style>
  .list { display: grid; margin-top: 56px; }
  /* Dotted rules between releases, like the capture list. */
  details { background: linear-gradient(90deg, var(--dark) 50%, transparent 0) bottom / 6px 1px repeat-x; }
  summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 20px;
    padding: 18px 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; margin-left: auto; font-weight: 600; }
  details[open]:not([data-closing]) summary::after { content: '−'; }
  summary:hover { background-color: var(--light-raised); }
  summary:hover .version { font-style: italic; }
  summary:focus-visible { outline: 2px solid var(--dark); outline-offset: 2px; }
  .version { font: 400 var(--step-2)/1.1 var(--display); }
  time { color: var(--on-light-muted); font-size: 0.85rem; }
  .tag { padding: 4px 8px; background: var(--dark); color: var(--white); font: 600 0.72rem/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; }

  .body { padding: 4px 0 28px; }
  .notes { max-width: 68ch; color: var(--on-light-muted); }
  .notes :global(:is(h1, h2, h3, h4)) { margin: 20px 0 8px; font: 600 0.78rem/1.3 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--dark); }
  .notes :global(:is(p, ul, ol)) { margin: 0 0 12px; }
  .notes :global(:is(ul, ol)) { padding-left: 1.2em; }
  .notes :global(li::marker) { color: var(--accent); }
  .notes :global(:is(strong, a, code)) { color: var(--dark); }
  .notes :global(img) { margin-block: 12px; }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 20px; }

  .all { margin-top: 28px; }
  .all a:hover { color: var(--accent); }
</style>
