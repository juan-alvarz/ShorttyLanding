---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale);
---
<div class="specs">
  <ul class="wrap">
    {t.specs.map((spec) => <li>{spec}</li>)}
  </ul>
</div>

<style>
  .specs { background: var(--light); }
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 28px;
    list-style: none;
    margin-block: 0;
    padding-block: 8px;
    font-size: 0.85rem;
    color: var(--on-light-muted);
  }
</style>
