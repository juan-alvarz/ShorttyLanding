---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale);
---
<div class="specs">
  <ul class="wrap">
    {t.specs.map((spec) => <li>{spec}</li>)}
  </ul>
</div>

<style>
  ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; list-style: none; margin-block: 0; padding-block: 8px; font: 500 0.75rem/1 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; }
  li { padding: 9px 12px; background: var(--tile); }
</style>
