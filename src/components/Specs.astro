---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale);
---
<div class="specs">
  <ul class="wrap">
    {t.specs.map((spec) => <li>{spec}</li>)}
  </ul>
</div>

<style>
  .specs { background: var(--light); }
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 0;
    list-style: none;
    margin-block: 0;
    padding-block: 8px 24px;
    color: var(--on-light-muted);
    font: italic 1rem var(--serif);
  }
  li + li::before { content: '·'; margin-inline: 14px; color: var(--accent); }
</style>
