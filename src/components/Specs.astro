---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale);
---
<div class="specs">
  <ul class="wrap">
    {t.specs.map((spec) => <li>{spec}</li>)}
  </ul>
</div>

<style>
  .specs { background: var(--dark); color: var(--white); }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0;
    list-style: none;
    margin-block: 0;
    padding-block: 0;
    font: 700 0.95rem/1 var(--display);
    text-transform: lowercase;
  }
  li { padding: 22px 0; }
  li:nth-child(odd) { color: var(--white); }
  li:nth-child(even) { color: var(--on-dark-muted); }
</style>
