---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale);
---
<div class="specs">
  <ul class="wrap">
    {t.specs.map((spec) => <li>{spec}</li>)}
  </ul>
</div>

<style>
  .specs { background: var(--dark); color: var(--on-dark-muted); }
  ul { display: flex; flex-wrap: wrap; gap: 8px 28px; list-style: none; margin-block: 0; padding-block: 0 24px; font: 500 0.75rem/1 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; }
  li::before { content: '— '; color: var(--accent); }
</style>
