---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale);
---
<div class="specs">
  <ul class="wrap">
    {t.specs.map((spec) => <li>{spec}</li>)}
  </ul>
</div>

<style>
  .specs { background: var(--dark); color: var(--white); }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 32px;
    list-style: none;
    margin-block: 0;
    padding-block: 22px;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  li::before { content: '✶ '; color: var(--accent); }
</style>
