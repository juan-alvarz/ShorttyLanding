---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale);
---
<div class="specs">
  <ul class="wrap">
    {t.specs.map((spec) => <li>{spec}</li>)}
  </ul>
</div>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 0;
    list-style: none;
    margin-block: 0;
    padding-block: 8px 40px;
    font: 500 1.05rem/1 var(--display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue-200);
  }
  li:not(:last-child)::after { content: '/'; margin-inline: 16px; color: var(--blue-700); }
</style>
