---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale);
---
<div class="specs">
  <ul class="wrap">
    {t.specs.map((spec) => <li>{spec}</li>)}
  </ul>
</div>

<style>
  .specs { background: var(--p8-black); color: var(--white); }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    list-style: none;
    margin-block: 0;
    padding-block: 26px;
    font: 400 0.8rem/1 var(--pixel);
    text-transform: uppercase;
  }
  li::before { content: '★ '; }
  li:nth-child(4n + 1)::before { color: var(--p8-yellow); }
  li:nth-child(4n + 2)::before { color: var(--p8-green); }
  li:nth-child(4n + 3)::before { color: var(--p8-blue); }
  li:nth-child(4n + 4)::before { color: var(--p8-pink); }
</style>
