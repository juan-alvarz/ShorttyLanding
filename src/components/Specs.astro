---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale);
---
<div class="specs">
  <ul class="wrap">
    {t.specs.map((spec) => <li>{spec}</li>)}
  </ul>
</div>

<style>
  .specs { background: var(--light); color: var(--dark); }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin-block: 0;
    padding-block: 0 56px;
    font: 500 0.78rem/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  li { padding: 9px 12px; background: var(--light-raised); }
</style>
