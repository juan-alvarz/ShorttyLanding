---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale);
---
<div class="specs">
  <ul class="wrap">
    {t.specs.map((spec) => <li>{spec}</li>)}
  </ul>
</div>

<style>
  .specs { background: var(--dark); color: var(--white); }
  ul { display: flex; flex-wrap: wrap; gap: 10px 28px; list-style: none; margin-block: 0; padding-block: 0 32px; font: 700 0.85rem/1 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-dark-muted); }
  li::before { content: '◆'; margin-right: 10px; color: var(--accent); font-size: 0.7rem; }
</style>
