---
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale);
---
<div class="specs">
  <ul class="wrap">
    {t.specs.map((spec) => <li>{spec}</li>)}
  </ul>
</div>

<style>
  .specs { background: var(--dark); padding-bottom: 8px; }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    list-style: none;
    margin-block: 0;
    padding-block: 28px;
    color: var(--on-dark-muted);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  li { display: flex; align-items: center; gap: 10px; }
  li::before { content: ''; width: 6px; height: 6px; background: var(--accent); }
</style>
