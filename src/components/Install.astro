---
import { RELEASES, REPO } from '../config';
import { useTranslations } from '../i18n';
const t = useTranslations(Astro.currentLocale).install;
---
<section id="install">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>

    <h3>{t.option1}</h3>
    <ol>
      {t.steps.map((step) => <li set:html={step.replace('{releases}', RELEASES)} />)}
    </ol>
    <p>{t.terminalNote}</p>
    <pre><code>xattr -dr com.apple.quarantine /Applications/Shortty.app</code></pre>
    <p>{t.update}</p>

    <h3>{t.option2}</h3>
    <p set:html={t.build} />
    <pre><code>brew install xcodegen
git clone {REPO}.git
cd Shortty
Scripts/install.sh</code></pre>
    <p>{t.buildUpdate} <code>git pull &amp;&amp; Scripts/install.sh</code></p>
  </div>
</section>

<style>
  ol { padding-left: 1.3em; max-width: 70ch; }
  ol li { margin-bottom: 0.7em; }
  h3 { margin-top: 2.4em; }
  .lead + h3 { margin-top: 2em; }
</style>
