---
import { RELEASES, REPO } from '../config';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale).install;
const unquarantine = 'xattr -dr com.apple.quarantine /Applications/Shortty.app';
const build = `brew install xcodegen\ngit clone ${REPO}.git\ncd Shortty\nScripts/install.sh`;
const update = 'git pull && Scripts/install.sh';
---
<section class="band ink" id="install">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>

    <div class="grid">
      <div>
        <h3>{t.download.title}</h3>
        <ol>
          {t.download.steps.map((step) => <li><span set:html={step.replace('{releases}', RELEASES)} /></li>)}
        </ol>
        <p class="note">{t.download.terminal}</p>
        <div class="code"><pre><code>{unquarantine}</code></pre><button type="button" data-copy={unquarantine}>{t.copy}</button></div>
        <p class="note">{t.download.update}</p>
      </div>
      <div>
        <h3>{t.build.title}</h3>
        <p class="note" set:html={t.build.text} />
        <div class="code"><pre><code>{build}</code></pre><button type="button" data-copy={build}>{t.copy}</button></div>
        <p class="note">{t.build.update}</p>
        <div class="code"><pre><code>{update}</code></pre><button type="button" data-copy={update}>{t.copy}</button></div>
      </div>
    </div>
  </div>
  <span hidden data-copied-text>{t.copied}</span>
</section>

<script>
  const copiedText = document.querySelector('[data-copied-text]')!.textContent!;
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const label = button.textContent!;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        button.textContent = copiedText;
        setTimeout(() => (button.textContent = label), 1600);
      } catch {
        // Clipboard not allowed here: select the text so it can be copied by hand.
        getSelection()?.selectAllChildren(button.previousElementSibling!);
      }
    });
  }
</script>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 64px; margin-top: 72px; }
  h3 { font: 800 var(--step-2)/1.1 var(--display); letter-spacing: -0.03em; margin-bottom: 28px; }

  ol { list-style: none; counter-reset: step; margin: 0 0 32px; padding: 0; display: grid; gap: 4px; }
  li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.2em minmax(0, 1fr);
    gap: 12px;
    padding: 14px 18px;
    background: var(--ink-raised);
    color: var(--on-ink-muted);
  }
  li::before { content: counter(step, decimal-leading-zero); color: var(--orange); font: 600 0.95rem var(--mono); }
  li :global(strong), li :global(a) { color: var(--white); }
  li :global(code), .note :global(code) { color: var(--white); }

  .note { color: var(--on-ink-muted); margin-bottom: 14px; }
  .note :global(a) { color: var(--white); }

  .code { position: relative; margin-bottom: 28px; background: var(--paper); color: var(--ink); }
  pre { margin: 0; padding: 18px 20px; padding-right: 88px; overflow-x: auto; font-size: 0.88rem; line-height: 1.7; }
  button {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 6px 10px;
    border: 0;
    background: var(--ink);
    color: var(--white);
    font: 500 0.75rem/1 var(--mono);
    cursor: pointer;
  }
  button:hover { background: var(--orange); color: var(--ink); }

  @media (max-width: 900px) { .grid { grid-template-columns: minmax(0, 1fr); gap: 48px; } }
</style>
