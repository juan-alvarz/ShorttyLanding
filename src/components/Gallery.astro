---
import { Image } from 'astro:assets';
import classic from '../assets/layout-classic.png';
import twoRows from '../assets/layout-two-rows.png';
import sidebars from '../assets/layout-sidebars.png';
import canvasFirst from '../assets/layout-canvas-first.png';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale).gallery;
const images = [classic, twoRows, sidebars, canvasFirst];
---
<section class="alt" id="layouts">
  <div class="wrap">
    <span class="label">{t.label}</span>
    <h2>{t.title}</h2>
    <p class="lead">{t.lead}</p>
    <div class="grid">
      {t.layouts.map((name, i) => (
        <figure>
          <Image src={images[i]} alt={`${t.altPrefix} ${name}`} widths={[480, 800]} sizes="(min-width: 800px) 540px, 100vw" />
          <figcaption>{name}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: 40px 28px; margin-top: 56px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  figure { margin: 0; }
  figcaption { margin-top: 12px; font: 0.8rem var(--mono); text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); }
</style>
