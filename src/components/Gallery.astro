---
import { Image } from 'astro:assets';
import classic from '../assets/layout-classic.png';
import twoRows from '../assets/layout-two-rows.png';
import sidebars from '../assets/layout-sidebars.png';
import canvasFirst from '../assets/layout-canvas-first.png';

const layouts = [
  ['Classic', classic],
  ['Two rows', twoRows],
  ['Sidebars', sidebars],
  ['Canvas first', canvasFirst],
];
---
<section class="alt" id="layouts">
  <div class="wrap">
    <h2>Make the editor yours</h2>
    <p class="lead">Pick the toolbar layout that fits how you work. Shortcuts, colors and behavior are customizable too.</p>
    <div class="grid">
      {layouts.map(([name, img]) => (
        <figure>
          <Image src={img} alt={`The ${name} editor layout`} widths={[480, 800]} sizes="(min-width: 800px) 520px, 100vw" />
          <figcaption>{name}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: 24px; margin-top: 40px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  figure { margin: 0; }
  img { border-radius: 12px; border: 1px solid var(--border); }
  figcaption { margin-top: 8px; color: var(--muted); font-size: 0.95rem; text-align: center; }
</style>
